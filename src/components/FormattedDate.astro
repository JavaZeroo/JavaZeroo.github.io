---
interface Props { date: Date; format?: 'full' | 'month' | 'day' }
const { date, format = 'full' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
// UTC getters, so the shown date always matches the permalink.
const y = date.getUTCFullYear(), m = pad(date.getUTCMonth() + 1), d = pad(date.getUTCDate());
const iso = `${y}-${m}-${d}`;
const shown = format === 'month' ? `${y}.${m}` : format === 'day' ? `${m}.${d}` : `${y}.${m}.${d}`;
---
<time datetime={iso}>{shown}</time>
