---
interface Props { date: Date; short?: boolean }
const { date, short = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
// UTC getters here too, so the shown date always matches the permalink.
const iso = `${date.getUTCFullYear()}-${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}`;
---
<time datetime={iso}>{short ? iso.slice(5) : iso}</time>
