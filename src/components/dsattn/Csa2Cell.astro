  { id: 'ri_q', x: 505, y: 215, w: 180, h: 56, kind: 'op', lines: own(['wq_b 1280→64×512', 'RoPE 末 64 维', '$q$ [64, 512]']) },
  { id: 'ri_score', x: 505, y: 300, w: 180, h: 88, kind: 'idx', strong: true, lines: ['重打分', '读共享 index_k', 'candidates 掩码 $-\\infty$', '→ top-512，sort', '写回 topk_idxs（覆盖）'] },
