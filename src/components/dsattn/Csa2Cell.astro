  { id: 'r_swa', x: 1165, y: 55, w: 190, h: 76, kind: 'op', lines: own(['SWA 路径（每层自有）', 'wkv 5120→512 + kv_norm', 'RoPE 末 64 → FP8', 'ring cache 128 槽']) },
  { id: 'r_attn', x: 965, y: 420, w: 180, h: 76, kind: 'main', strong: true, lines: own(['sparse_attn（每层自有）', '读共享 compress_kv', '+ 共享 topk_idxs', '+ SWA 128 + sink → 反旋转']) },
  { id: 'r_out', x: 1165, y: 420, w: 190, h: 64, kind: 'out', lines: own(['输出投影（每层自有）', 'wo_a 8 组 ×(4096→1024)', 'wo_b 8192→5120']) },
  // ---- 跨层共享池 ----
  { id: 'p_kv', x: 60, y: 705, w: 280, h: 56, kind: 'pool', strong: true, lines: ['compress_kv', '主 KV latent，FP4（288 B/条）'] },
