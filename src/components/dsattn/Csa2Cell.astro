  { id: 'f_q', x: 45, y: 215, w: 180, h: 56, kind: 'op', lines: own(['wq_b 1280→64×512', 'RoPE 末 64 维', '$q$ [64, 512]']) },
  { id: 'f_iq', x: 45, y: 320, w: 180, h: 76, kind: 'idx', lines: ['indexer Q（每层自有）', 'wq_b 1280→32×128', 'weights_proj 5120→32', 'FP4'] },
  { id: 'f_swa', x: 45, y: 440, w: 180, h: 76, kind: 'op', lines: own(['SWA 路径（每层自有）', 'wkv 5120→512 + kv_norm', 'RoPE 末 64 → FP8', 'ring cache 128 槽']) },
  { id: 'f_attn', x: 45, y: 545, w: 180, h: 64, kind: 'main', strong: true, lines: own(['sparse_attn（每层自有）', 'SWA 128 + 全局 top-512', '+ sink → 反旋转 RoPE']) },
  { id: 'f_comp', x: 245, y: 130, w: 190, h: 88, kind: 'mla', lines: ['Compressor', 'wkv、wgate 5120→512', 'softmax(gate)⊙kv', '按 m 求和（不重叠）', 'm=1 无 wgate（层 20）'] },
  { id: 'f_lat', x: 245, y: 250, w: 190, h: 64, kind: 'mla', lines: ['latent [N/m, 512]', 'RoPE 末 64 维 → FP4', 'E2M1 + E4M3 scale/16'] },
  { id: 'f_ik', x: 245, y: 360, w: 190, h: 76, kind: 'idx', lines: ['indexer K', 'wk 512→128 + k_norm', 'RoPE θ=160000 → FP4', 'E8M0/32，无 Hadamard'] },
  { id: 'f_score', x: 245, y: 480, w: 190, h: 88, kind: 'idx', strong: true, lines: ['打分 $\\sum_h w_h\\,\\mathrm{ReLU}(qk)$', '因果掩码 → top-512', '按位置 sort', '层 20 另产 candidates', '（2048 块 × 8 = 16384）'] },
