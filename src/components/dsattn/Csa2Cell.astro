/**
 * CSA2（DeepSeek-V4.1-Flash）三种层模式的算子流：Full / Reindex / Reuse 三列并排，
 * 底部一条跨层共享池（SharedAttentionRuntime 的四个槽：compress_kv、index_k、topk_idxs、
 * candidates；356 B/条 × 2.5 条/token = 890 B/token）。
 * Full（层 2/8/14：m=2 有 wgate；层 20：m=1 无 wgate）：自己压 main KV（Compressor：
 * softmax(gate)⊙kv 按 m 个不重叠 token 求和、无 APE），indexer K 从主 KV latent 投影
 * （wk 512→128，无 Hadamard），跑 indexer 产 top-512（层 20 另产 candidates 候选池
 * ≤2048 块×8=16384），全部写进共享池。Reindex（层 24/28/32/36）：只有自己的 indexer Q
 * 和 weights_proj，读共享 index_k 重打分、先经 candidates 掩码再 top-512，把新 topk_idxs
 * 写回。Reuse（30 层）：只有自己的 Q/SWA/O，直接读共享 compress_kv + topk_idxs 进
 * sparse_attn。Q 低秩（wq_a 5120→1280 → wq_b →64×512）、SWA（128 槽 FP8 ring）、
 * sparse_attn + sink + 反旋转、分组输出（wo_a 8 组 ×(4096→1024) → wo_b 8192→5120）
 * 是三列每层自有的公共部分。实线 = 层内流 / 写池，虚线 = 从池读。无 props。
 */
import FlowDiagram from '../figures/FlowDiagram.astro';

const own = (lines: string[]) => lines; // 语义标记：每层自有的公共部分

const nodes = [
  // ---- Full 列 ----
