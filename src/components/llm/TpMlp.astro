---
/**
 * Megatron 张量并行的 MLP：A 按列切、B 按行切，中间的 GeLU 不需要通信，末尾一次 all-reduce。
 * f / g 是一对共轭算子：f 前向恒等、反向 all-reduce；g 前向 all-reduce、反向恒等。
 */
import SvgTex from '../k3/SvgTex.astro';
import { texMix } from '../k3/tex';
const caption = 'Megatron 的 MLP 切法。$A$ 按列切成 $[A_1\\ A_2]$，每卡算 $\\mathrm{GeLU}(XA_i)$，逐元素的非线性不跨列，所以中间不通信；$B$ 按行切成 $[B_1; B_2]$，每卡算出一个部分和 $Y_i$，一次 all-reduce 相加。$f$ 和 $g$ 是一对共轭算子：前向 $f$ 恒等、$g$ all-reduce，反向反过来。一层 MLP 前向一次、反向一次 all-reduce，注意力子层同理，所以每层每个 micro-batch 共四次。';
const lanes = [
  { y: 70, i: 1 }, { y: 200, i: 2 },
];
---
<figure class="fig">
  <svg viewBox="0 0 1100 350" role="img" aria-label="张量并行的 MLP 切法">
    <defs>
      <marker id="tp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" /></marker>
    </defs>

    <!-- 输入 X（复制） -->
    <rect class="act" x="24" y="140" width="64" height="64" rx="7" />
    <SvgTex x={56} y={166} size={12} weight={600} src="$X$" />
    <SvgTex x={56} y={184} size={9.5} color="var(--text-2)" src="$S\times d$" />
    <SvgTex x={56} y={224} size={9.5} color="var(--muted)" src="两卡各一份" />
    <circle class="fg" cx="124" cy="172" r="15" /><SvgTex x={124} y={172} size={12} weight={600} src="$f$" />
    <line class="edge" x1="88" y1="172" x2="107" y2="172" />
    <path class="edge" d="M139 172 C 155 172, 150 105, 168 105" marker-end="url(#tp-arrow)" />
    <path class="edge" d="M139 172 C 155 172, 150 235, 168 235" marker-end="url(#tp-arrow)" />

    {lanes.map((l) => (
      <g>
        <rect class="dev" x="160" y={l.y - 20} width="470" height="110" rx="10" />
        <SvgTex x={172} y={l.y - 6} size={10} align="start" color="var(--muted)" src={`GPU ${l.i - 1}`} />
        <rect class:list={['wt', { w2: l.i === 2 }]} x="172" y={l.y + 10} width="104" height="50" rx="6" />
        <SvgTex x={224} y={l.y + 27} size={11.5} weight={600} src={`$X A_${l.i}$`} />
        <SvgTex x={224} y={l.y + 46} size={9.5} color="var(--text-2)" src={`$A_${l.i}$：$d\\times 2d$`} />
        <line class="edge" x1="276" y1={l.y + 35} x2="300" y2={l.y + 35} marker-end="url(#tp-arrow)" />
        <rect class="op" x="302" y={l.y + 10} width="74" height="50" rx="6" />
        <SvgTex x={339} y={l.y + 27} size={11.5} weight={600} src="GeLU" />
        <SvgTex x={339} y={l.y + 46} size={9.5} color="var(--text-2)" src="逐元素" />
        <line class="edge" x1="376" y1={l.y + 35} x2="400" y2={l.y + 35} marker-end="url(#tp-arrow)" />
        <rect class:list={['wt', { w2: l.i === 2 }]} x="402" y={l.y + 10} width="104" height="50" rx="6" />
        <SvgTex x={454} y={l.y + 27} size={11.5} weight={600} src={`$\\cdot\\, B_${l.i}$`} />
        <SvgTex x={454} y={l.y + 46} size={9.5} color="var(--text-2)" src={`$B_${l.i}$：$2d\\times d$`} />
        <line class="edge" x1="506" y1={l.y + 35} x2="530" y2={l.y + 35} marker-end="url(#tp-arrow)" />
        <rect class="act" x="532" y={l.y + 10} width="84" height="50" rx="6" />
        <SvgTex x={574} y={l.y + 27} size={11.5} weight={600} src={`$Y_${l.i}$`} />
        <SvgTex x={574} y={l.y + 46} size={9.5} color="var(--text-2)" src="部分和，$S\times d$" />
      </g>
    ))}

    <path class="edge" d="M630 105 C 650 105, 645 172, 664 172" />
    <path class="edge" d="M630 235 C 650 235, 645 172, 664 172" />
    <circle class="fg comm" cx="680" cy="172" r="16" /><SvgTex x={680} y={172} size={12} weight={600} src="$g$" />
    <line class="edge" x1="696" y1="172" x2="722" y2="172" marker-end="url(#tp-arrow)" />
    <rect class="act" x="724" y="140" width="96" height="64" rx="7" />
    <SvgTex x={772} y={162} size={11.5} weight={600} src="$Y = Y_1 + Y_2$" />
    <SvgTex x={772} y={184} size={9.5} color="var(--text-2)" src="两卡各一份" />
    <SvgTex x={680} y={210} size={9.5} weight={600} color="var(--cat-amber)" src="all-reduce" />

    <SvgTex x={420} y={330} size={10.5} color="var(--text-2)" src="$f$：前向恒等，反向 all-reduce　　$g$：前向 all-reduce，反向恒等　　两者互为反向" />

    <!-- 右：矩阵怎么切 -->
    <SvgTex x={960} y={44} size={11} weight={600} color="var(--text-2)" src="$A$ 按列切（$d\times 4d$）" />
    <rect class="wt" x="880" y="60" width="80" height="60" rx="4" />
    <rect class="wt w2" x="960" y="60" width="80" height="60" rx="4" />
    <SvgTex x={920} y={90} size={11.5} weight={600} src="$A_1$" />
    <SvgTex x={1000} y={90} size={11.5} weight={600} src="$A_2$" />
    <SvgTex x={960} y={134} size={9.5} color="var(--text-2)" src="$XA = [XA_1\ \ XA_2]$，各卡算一半的列" />

    <SvgTex x={960} y={168} size={11} weight={600} color="var(--text-2)" src="$B$ 按行切（$4d\times d$）" />
    <rect class="wt" x="930" y="184" width="60" height="50" rx="4" />
    <rect class="wt w2" x="930" y="234" width="60" height="50" rx="4" />
    <SvgTex x={960} y={209} size={11.5} weight={600} src="$B_1$" />
    <SvgTex x={960} y={259} size={11.5} weight={600} src="$B_2$" />
    <SvgTex x={960} y={302} size={9.5} color="var(--text-2)" src="$[H_1\ H_2]\begin{bmatrix}B_1\\ B_2\end{bmatrix} = H_1B_1 + H_2B_2$" />
    <SvgTex x={960} y={322} size={9.5} color="var(--text-2)" src="部分和要相加，这就是 all-reduce" />
  </svg>
  <figcaption set:html={texMix(caption)} />
</figure>

<style>
  .fig { margin: 2rem 0; padding: 0.8rem 0.6rem 0.6rem; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); overflow-x: auto; }
  .fig svg { display: block; width: 100%; min-width: 760px; height: auto; font-family: var(--font-sans); }
  .fig marker path { fill: var(--text-2); }
  .edge { fill: none; stroke: var(--text-2); stroke-width: 1.4; }
  .dev { fill: color-mix(in srgb, var(--muted) 8%, var(--bg-2)); stroke: var(--border-2); stroke-width: 1.2; }
  .act { fill: color-mix(in srgb, var(--cat-cyan) 22%, var(--bg-2)); stroke: var(--cat-cyan); stroke-width: 1.2; }
  .wt { fill: color-mix(in srgb, var(--cat-indigo) 22%, var(--bg-2)); stroke: var(--cat-indigo); stroke-width: 1.2; }
  .wt.w2 { fill: color-mix(in srgb, var(--cat-indigo) 44%, var(--bg-2)); }
  .op { fill: var(--bg-2); stroke: var(--text-2); stroke-width: 1.2; }
  .fg { fill: var(--bg-2); stroke: var(--text-2); stroke-width: 1.4; }
  .fg.comm { fill: color-mix(in srgb, var(--cat-amber) 26%, var(--bg-2)); stroke: var(--cat-amber); }
  figcaption { margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-2); line-height: 1.6; text-align: center; }
</style>
