---
/**
 * 双槽位轮转示意（第 9、10 篇复用三次）：GPU 上只留两个槽，一个在用、一个在预取下一块。
 * 用 props 换文字：store 是槽位外的存储，items 是流过槽位的东西。
 */
import SvgTex from './SvgTex.astro';
import { texMix } from './tex';
interface Props { store: string; item: string; slotA: string; slotB: string; use: string; fill: string; caption: string; id: string }
const { store, item, slotA, slotB, use, fill, caption, id } = Astro.props;
---
<figure class="dual">
  <svg viewBox="0 0 640 190" role="img" aria-label="双槽位轮转示意">
    <defs>
      <marker id={`dual-arr-${id}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" /></marker>
    </defs>
    <rect class="store" x="20" y="40" width="170" height="110" rx="10" />
    <SvgTex x={105} y={58} size={12} weight={600} src={store} />
    <SvgTex x={105} y={76} size={9.5} color="var(--text-2)" src={`按 ${item} 分块`} />
    {[0, 1, 2, 3].map((i) => (
      <g>
        <rect class="chunk" x={38 + i * 36} y={92} width="30" height="34" rx="4" />
        <SvgTex x={53 + i * 36} y={109} size={10} color="var(--text-2)" src={String(i + 1)} />
      </g>
    ))}
    <rect class="gpu" x="300" y="30" width="320" height="130" rx="10" />
    <SvgTex x={460} y={48} size={12} weight={600} src="GPU 上的两个槽位" />
    <rect class="slot use" x="320" y="70" width="130" height="66" rx="8" />
    <SvgTex x={385} y={92} size={11.5} weight={600} src={slotA} />
    <SvgTex x={385} y={114} size={10} color="var(--text-2)" src={use} />
    <rect class="slot fill" x="470" y="70" width="130" height="66" rx="8" />
    <SvgTex x={535} y={92} size={11.5} weight={600} src={slotB} />
    <SvgTex x={535} y={114} size={10} color="var(--text-2)" src={fill} />
    <path class="edge" d="M 190 108 C 240 108, 250 103, 468 103" marker-end={`url(#dual-arr-${id})`} />
    <path class="edge swap" d="M 535 140 C 535 170, 385 170, 385 140" marker-end={`url(#dual-arr-${id})`} />
    <SvgTex x={460} y={176} size={10} color="var(--muted)" src="用完交换角色" />
  </svg>
  <figcaption set:html={texMix(caption)} />
</figure>

<style>
  .dual { margin: 2rem 0; padding: 0.8rem 0.6rem 0.6rem; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); overflow-x: auto; }
  .dual svg { display: block; width: 100%; max-width: 640px; margin: 0 auto; height: auto; font-family: var(--font-sans); }
  .dual marker path { fill: var(--text-2); }
  .dual .store { fill: color-mix(in srgb, var(--muted) 14%, var(--bg-2)); stroke: var(--muted); stroke-width: 1.3; }
  .dual .chunk { fill: var(--bg-2); stroke: var(--border-2); stroke-width: 1.1; }
  .dual .gpu { fill: color-mix(in srgb, var(--cat-cyan) 8%, var(--bg-2)); stroke: var(--cat-cyan); stroke-width: 1.4; }
  .dual .slot { stroke-width: 1.5; }
  .dual .slot.use { fill: color-mix(in srgb, var(--cat-emerald) 22%, var(--bg-2)); stroke: var(--cat-emerald); }
  .dual .slot.fill { fill: color-mix(in srgb, var(--cat-amber) 22%, var(--bg-2)); stroke: var(--cat-amber); }
  .dual .edge { fill: none; stroke: var(--text-2); stroke-width: 1.4; }
  .dual .edge.swap { stroke-dasharray: 5 4; }
  figcaption { margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-2); line-height: 1.6; text-align: center; }
</style>
