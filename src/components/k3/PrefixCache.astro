---
/**
 * KDA 感知的前缀缓存（论文 Fig. 12）：一个 6144-token 物理块 = 12 个 512-token 哈希块。
 * MLA 的 KV 按哈希块细粒度命中；KDA 状态只在稀疏边界存 checkpoint；命中点 = 两者都满足的最长边界。
 */
const N = 12, BW = 60, X0 = 40, Y = 60, H = 40;
const cached = 5;                      // 前 5 个哈希块的 MLA KV 已缓存（0..2559）
const ckpt = new Set([2, 5, 9]);       // 边界索引（哈希块右端）有 KDA checkpoint：1024、2560、4608
const hit = 5;                         // 命中边界 B = 5 × 512 = 2560
const bx = (i: number) => X0 + i * BW;
---

<figure class="pc">
  <svg viewBox="0 0 800 230" role="img" aria-label="KDA 感知的前缀缓存示意">
    <text class="lbl" x={X0} y="26">一个物理块 = 6144 token = 12 个哈希块（每个 512 token）</text>
    <rect class="phys" x={X0 - 4} y={Y - 4} width={N * BW + 8} height={H + 8} rx="6" />
    {Array.from({ length: N }, (_, i) => (
      <g>
        <rect class:list={['hb', { cached: i < cached }]} x={bx(i)} y={Y} width={BW - 2} height={H} rx="3" />
        <text class="idx" x={bx(i) + BW / 2 - 1} y={Y + H / 2 + 4} text-anchor="middle">{i * 512}</text>
      </g>
    ))}
    <!-- KDA checkpoint 标记：画在哈希块右端边界 -->
    {Array.from({ length: N }, (_, i) => {
      const x = bx(i) + BW - 1;
      const has = ckpt.has(i);
      return (
        <g>
          <circle class:list={['ck', { has, hit: i === hit - 1 }]} cx={x} cy={Y + H + 22} r={has ? 6 : 4} />
        </g>
      );
    })}
    <text class="lbl" x={X0} y={Y + H + 50}>○ 无 KDA checkpoint　● 有 checkpoint（通常在对话轮次边界）　● 本次命中</text>

    <!-- 命中点 -->
    <line class="hitline" x1={bx(hit - 1) + BW - 1} y1={Y - 14} x2={bx(hit - 1) + BW - 1} y2={Y + H + 10} />
    <text class="hitl" x={bx(hit - 1) + BW - 1} y={Y - 20} text-anchor="middle">命中边界 B = 2560</text>

    <!-- 图例 -->
    <rect class="hb cached" x={X0} y="160" width="16" height="12" rx="2" /><text class="lbl" x={X0 + 22} y="170">MLA KV 已缓存（链式哈希匹配到这里）</text>
    <rect class="hb" x={X0 + 300} y="160" width="16" height="12" rx="2" /><text class="lbl" x={X0 + 322} y="170">空，从 B 开始接着 prefill</text>
    <text class="lbl" x={X0} y="198">请求前 2800 个 token 与缓存前缀相同 → 恢复 B = 2560 处的 KDA checkpoint，写时复制半满的 MLA 块，从 2560 继续算，[0, 2560) 不重算。</text>
    <text class="lbl" x={X0} y="216">如果只按 6144 的物理块做哈希，这个请求什么都命中不了。</text>
  </svg>
</figure>

<style>
  .pc { margin: 2rem 0; padding: 0.8rem 0.6rem 0.4rem; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); overflow-x: auto; }
  .pc svg { display: block; width: 100%; min-width: 640px; height: auto; font-family: var(--font-sans); }
  .phys { fill: none; stroke: var(--border-2); stroke-dasharray: 5 4; }
  .hb { fill: color-mix(in srgb, var(--muted) 14%, var(--bg-2)); stroke: var(--border-2); stroke-width: 1; }
  .hb.cached { fill: color-mix(in srgb, var(--cat-indigo) 45%, var(--bg-2)); stroke: var(--cat-indigo); }
  .idx { fill: var(--text-2); font-size: 9.5px; }
  .ck { fill: var(--bg-2); stroke: var(--muted); stroke-width: 1.2; }
  .ck.has { fill: var(--text-2); stroke: var(--text-2); }
  .ck.hit { fill: var(--cat-amber); stroke: var(--cat-amber); }
  .hitline { stroke: var(--cat-amber); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .hitl { fill: var(--cat-amber); font-size: 11px; font-weight: 600; }
  .lbl { fill: var(--text-2); font-size: 10.5px; }
</style>
