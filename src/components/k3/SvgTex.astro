---
/**
 * 在 SVG 里放一段 KaTeX 渲染的文字（可中英混排，`$...$` 走公式）。
 * 用 <foreignObject> 承载 HTML；(x, y) 是锚点：y 是垂直中心，x 按 align 是左端 / 中心 / 右端。
 */
import { texMix } from './tex';
interface Props {
  x: number; y: number; w: number; h?: number;
  size?: number; align?: 'start' | 'middle' | 'end';
  color?: string; weight?: number | string; src: string;
}
const { x, y, w, h = 28, size = 12, align = 'middle', color = 'var(--text)', weight = 400, src } = Astro.props;
const left = align === 'middle' ? x - w / 2 : align === 'end' ? x - w : x;
const justify = align === 'middle' ? 'center' : align === 'end' ? 'flex-end' : 'flex-start';
---
<foreignObject x={left} y={y - h / 2} width={w} height={h} style="overflow: visible">
  <div xmlns="http://www.w3.org/1999/xhtml" class="svgtex" style={`font-size:${size}px;justify-content:${justify};color:${color};font-weight:${weight}`} set:html={texMix(src)} />
</foreignObject>

<style is:global>
  .svgtex { display: flex; align-items: center; width: 100%; height: 100%; white-space: nowrap; line-height: 1; font-family: var(--font-sans); }
  .svgtex .katex { font-size: 1.08em; line-height: 1; }
</style>
