---
/**
 * 线性注意力 → KDA 的谱系流程图。
 * 两条路径从线性注意力分出：左边「忘」（加衰减、不擦），右边「擦」（delta rule、不忘），在 KDA 汇合。
 * RWKV-7 与 KDA 并排（同为对角衰减 + 擦除，KDA 是 a = b = k 的特例）；Longhorn、Comba 是旁支。
 * 每个节点可点击，跳到正文对应的小节。
 *
 * 渲染两份 SVG：宽屏三列（主线两列 + 旁支一列），窄屏两段（主线在上，旁支列在下），CSS 按宽度切换。
 */
import SvgTex from './SvgTex.astro';
type Kind = 'root' | 'forget' | 'erase' | 'kda' | 'leaf';
interface Spec { id: string; kind: Kind; name: string; formula: string; note?: string; badge?: string; wide?: boolean }
interface Node extends Spec { cx: number; y: number; w: number }
interface Edge { d: string; kind: 'forget' | 'erase' | 'leaf' | 'kda'; label: string; lx: number; ly: number; anchor?: 'start' | 'middle' | 'end'; dashed?: boolean }

const H = 66;
const specs: Record<string, Spec> = {
  la: { id: '线性注意力', kind: 'root', name: '线性注意力 2020', formula: 'S = S + k v^\\top', note: '只加不擦，目标无下界' },
  ret: { id: 'retnet-和-mamba2', kind: 'forget', name: 'RetNet 2023 · Mamba2 2024', formula: 'S = \\alpha S + k v^\\top', note: '$\\alpha$ 每头一个标量', badge: 'Mamba2：三个合成任务全挂' },
  dn: { id: 'deltanet', kind: 'erase', name: 'DeltaNet 2021', formula: 'S = (I - \\beta k k^\\top)\\, S + \\beta k v^\\top', note: '在 $k$ 方向先擦再写' },
  lh: { id: 'longhorn', kind: 'leaf', name: 'Longhorn 2024', formula: '\\beta \;\\to\; \\beta / (1 + \\beta k^\\top k)', note: '一步 SGD 换成闭式解' },
  gla: { id: 'gla-和-hgrn2', kind: 'forget', name: 'GLA 2023 · HGRN2 2024', formula: 'S = \\operatorname{Diag}(\\alpha)\\, S + k v^\\top', note: '$\\alpha$ 每个键通道一个' },
  gdn: { id: 'gated-deltanet', kind: 'erase', name: 'Gated DeltaNet 2024', formula: 'S = (I - \\beta k k^\\top)\\, \\alpha S + \\beta k v^\\top', note: '先忘，再擦，再写', badge: '收敛慢于 KDA' },
  cb: { id: 'comba', kind: 'leaf', name: 'Comba 2025', formula: 'S = (\\alpha - b\\beta k k^\\top)\\, S + \\beta k v^\\top', note: '擦得比写得少（$b<1$），读出用 $q - d\\,k$' },
  kda: { id: 'kda', kind: 'kda', name: 'KDA 2025', formula: 'S = (I - \\beta k k^\\top)\\operatorname{Diag}(\\alpha)\\, S + \\beta k v^\\top', note: '先逐通道忘，再擦，再写', wide: true },
  rw: { id: 'rwkv-7', kind: 'leaf', name: 'RWKV-7 2025', formula: 'S = (\\operatorname{Diag}(\\alpha) - (a \\odot \\hat\\kappa)\\hat\\kappa^\\top)\\, S + \\tilde k v^\\top', note: '一般 DPLR：擦除键 $\\hat\\kappa$、写入键 $\\tilde k$ 各不相同', wide: true },
};

const left = (n: Node) => n.cx - n.w / 2;
const right = (n: Node) => n.cx + n.w / 2;
const down = (a: Node, b: Node) => {
  const y1 = a.y + H, y2 = b.y, ym = (y1 + y2) / 2;
  return `M${a.cx} ${y1} V ${ym} H ${b.cx} V ${y2 - 2}`;
};
const across = (a: Node, b: Node) => `M${right(a)} ${a.y + H / 2} H ${left(b) - 2}`;
const mid = (a: Node, b: Node) => (right(a) + left(b)) / 2;

const mk = (s: Spec, cx: number, y: number, w: number): Node => ({ ...s, cx, y, w });
const lbl = (x: number, y: number, anchor: 'start' | 'end' = 'start') => ({ lx: x, ly: y, anchor });

interface Layout { vb: string; nodes: Node[]; edges: Edge[]; heads: { x: number; t: string }[]; foot: { y: number; t: string } }

// ---- 宽屏：三列，主线两列 + 旁支一列 ----
const WIDE: Layout = (() => {
  const W = 224, R = [28, 150, 290, 440], XL = 124, XM = 372, XR = 690, XC = (XL + XM) / 2;
  const la = mk(specs.la, XC, R[0], W);
  const ret = mk(specs.ret, XL, R[1], W), dn = mk(specs.dn, XM, R[1], W), lh = mk(specs.lh, XR, R[1], W);
  const gla = mk(specs.gla, XL, R[2], W), gdn = mk(specs.gdn, XM, R[2], W), cb = mk(specs.cb, XR, R[2], W);
  const kda = mk(specs.kda, XC, R[3], W + 40), rw = mk(specs.rw, XR, R[3], W + 40);
  const edges: Edge[] = [
    { d: down(la, ret), kind: 'forget', label: '+ 标量衰减 $\\alpha$（忘）', ...lbl(XL + 8, R[1] - 14) },
    { d: down(la, dn), kind: 'erase', label: '内积目标 → 回归目标（擦）', ...lbl(XM + 8, R[1] - 14) },
    { d: down(ret, gla), kind: 'forget', label: '标量 → 逐通道', ...lbl(XL + 8, R[2] - 30) },
    { d: down(dn, gdn), kind: 'erase', label: '+ 标量衰减 $\\alpha$（忘）', ...lbl(XM + 8, R[2] - 30) },
    { d: down(gla, kda), kind: 'kda', label: '+ delta rule（擦）', ...lbl(XL + 8, R[3] - 32) },
    { d: down(gdn, kda), kind: 'kda', label: '标量 → 逐通道', ...lbl(XM + 8, R[3] - 32) },
    { d: across(dn, lh), kind: 'leaf', label: '隐式解', ...lbl(mid(dn, lh), R[1] + H / 2 - 6, 'middle' as never) },
    { d: across(gdn, cb), kind: 'leaf', label: '擦除 × $b$', ...lbl(mid(gdn, cb), R[2] + H / 2 - 6, 'middle' as never) },
    { d: across(kda, rw), kind: 'leaf', label: '放开绑定', ...lbl(mid(kda, rw), R[3] + H / 2 - 6, 'middle' as never), dashed: true },
  ];
  return {
    vb: '0 0 836 540',
    nodes: [la, ret, dn, lh, gla, gdn, cb, kda, rw],
    edges,
    heads: [{ x: XL, t: '「忘」路径：加衰减，不擦' }, { x: XM, t: '「擦」路径：delta rule，不忘' }, { x: XR, t: '旁支' }],
    foot: { y: 530, t: '竖边 = 主线，每条边标注「加了什么」；横边 = 旁支。虚线：KDA 是 RWKV-7 这类一般 DPLR 转移的特例。点击节点跳到对应小节。' },
  };
})();

// ---- 窄屏：两列主线，旁支插在父节点正下方，用短边接上 ----
const NARROW: Layout = (() => {
  const W = 224, XL = 124, XM = 372, XC = (XL + XM) / 2;
  const yLA = 28, y1 = 150, yLH = 246, y2 = 340, yCB = 436, y3 = 540, yRW = 640;
  const la = mk(specs.la, XC, yLA, W);
  const ret = mk(specs.ret, XL, y1, W), dn = mk(specs.dn, XM, y1, W), lh = mk(specs.lh, 400, yLH, 200);
  const gla = mk(specs.gla, XL, y2, W), gdn = mk(specs.gdn, XM, y2, W), cb = mk(specs.cb, 400, yCB, 220);
  const kda = mk(specs.kda, XC, y3, W + 40), rw = mk(specs.rw, 300, yRW, W + 40);
  const XE = 282;   // 右列主线的边走在旁支左侧
  const XB = 440;   // 旁支的短边
  const edges: Edge[] = [
    { d: down(la, ret), kind: 'forget', label: '+ 标量衰减 $\\alpha$（忘）', ...lbl(XL - 8, y1 - 14, 'end') },
    { d: down(la, dn), kind: 'erase', label: '→ 回归目标（擦）', ...lbl(XM - 8, y1 - 14, 'end') },
    { d: `M${XL} ${y1 + H} V ${y2 - 2}`, kind: 'forget', label: '标量 → 逐通道', ...lbl(XL - 8, y2 - 40, 'end') },
    { d: `M${XE} ${y1 + H} V ${y2 - 2}`, kind: 'erase', label: '+ 标量衰减 $\\alpha$（忘）', ...lbl(XE - 8, y2 - 40, 'end') },
    { d: `M${XL} ${y2 + H} V ${(y2 + H + y3) / 2} H ${XC} V ${y3 - 2}`, kind: 'kda', label: '+ delta rule（擦）', ...lbl(XL - 8, y3 - 62, 'end') },
    { d: `M${XE - 10} ${y2 + H} V ${(y2 + H + y3) / 2} H ${XC} V ${y3 - 2}`, kind: 'kda', label: '标量 → 逐通道', ...lbl(XE - 18, y3 - 62, 'end') },
    { d: `M${XB} ${y1 + H} V ${yLH - 2}`, kind: 'leaf', label: '隐式解', ...lbl(XB + 8, yLH - 10) },
    { d: `M${XB} ${y2 + H} V ${yCB - 2}`, kind: 'leaf', label: '擦除 × $b$', ...lbl(XB + 8, yCB - 10) },
    { d: `M300 ${y3 + H} V ${yRW - 2}`, kind: 'leaf', label: '放开绑定', ...lbl(308, yRW - 12), dashed: true },
  ];
  return {
    vb: '0 0 530 750',
    nodes: [la, ret, dn, lh, gla, gdn, cb, kda, rw],
    edges,
    heads: [{ x: XL, t: '「忘」路径：加衰减，不擦' }, { x: XM, t: '「擦」路径：delta rule，不忘' }],
    foot: { y: 740, t: '实线边标注「加了什么」；虚线框是旁支，挂在它改动的那个节点下面。点击节点跳到对应小节。' },
  };
})();

const variants = [{ cls: 'wide', L: WIDE }, { cls: 'narrow', L: NARROW }];
---

<figure class="lin">
  {variants.map(({ cls, L }) => (
    <svg class={cls} viewBox={L.vb} role="img" aria-label="从线性注意力到 KDA 的谱系：忘路径、擦路径与旁支">
      <defs>
        <marker id={`lin-arrow-${cls}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" />
        </marker>
      </defs>

      {L.heads.map((h) => <text class="col" x={h.x} y="14" text-anchor="middle">{h.t}</text>)}

      {L.edges.map((e) => (
        <g class:list={['edge', e.kind, { dashed: e.dashed }]}>
          <path d={e.d} marker-end={`url(#lin-arrow-${cls})`} />
          <SvgTex x={e.lx} y={e.ly - 4} w={170} h={16} size={10.5} align={e.anchor ?? 'start'} color="var(--text-2)" src={e.label} />
        </g>
      ))}

      {L.nodes.map((n) => (
        <a href={`#${n.id}`}>
          <g class:list={['node', n.kind]}>
            <title>{n.name}</title>
            <rect x={left(n)} y={n.y} width={n.w} height={H} rx="8" />
            <text class="name" x={n.cx} y={n.y + 18} text-anchor="middle">{n.name}</text>
            <SvgTex x={n.cx} y={n.y + 35} w={n.w - 8} h={20} size={11.5} src={`$${n.formula}$`} />
            {n.note && <SvgTex x={n.cx} y={n.y + 52} w={n.w - 8} h={16} size={10} color="var(--text-2)" src={n.note} />}
            {n.badge && <text class="badge" x={n.cx} y={n.y + H + 13} text-anchor="middle">{n.badge}</text>}
          </g>
        </a>
      ))}

      <text class="foot" x="12" y={L.foot.y}>{L.foot.t}</text>
    </svg>
  ))}
</figure>

<style>
  .lin { margin: 2rem 0; padding: 0.8rem 0.6rem 0.4rem; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); }
  .lin svg { display: block; width: 100%; height: auto; font-family: var(--font-sans); }
  .lin .narrow { display: none; }
  @media (max-width: 640px) {
    .lin .wide { display: none; }
    .lin .narrow { display: block; }
  }
  .col { fill: var(--muted); font-size: 11px; letter-spacing: 0.04em; }
  .node rect { fill: var(--bg-2); stroke-width: 1.5; }
  .node.root rect { stroke: var(--text-2); }
  .node.forget rect { fill: color-mix(in srgb, var(--cat-amber) 10%, var(--bg-2)); stroke: var(--cat-amber); }
  .node.erase rect { fill: color-mix(in srgb, var(--cat-rose) 10%, var(--bg-2)); stroke: var(--cat-rose); }
  .node.kda rect { fill: color-mix(in srgb, var(--cat-cyan) 14%, var(--bg-2)); stroke: var(--cat-cyan); stroke-width: 2.2; }
  .node.leaf { opacity: 0.72; }
  .node.leaf rect { stroke: var(--text-2); stroke-dasharray: 4 3; }
  .lin a:hover .node rect, .lin a:focus-visible .node rect { stroke-width: 2.6; }
  .lin a:focus-visible { outline: none; }
  .name { fill: var(--text); font-size: 12.5px; font-weight: 600; }
  .badge { fill: var(--cat-rose); font-size: 10px; }
  .edge path { fill: none; stroke-width: 1.6; }
  .edge.forget path { stroke: var(--cat-amber); }
  .edge.erase path { stroke: var(--cat-rose); }
  .edge.kda path { stroke: var(--cat-cyan); }
  .edge.leaf path { stroke: var(--text-2); }
  .edge.dashed path { stroke-dasharray: 5 4; }
  marker path { fill: var(--text-2); }
  .foot { fill: var(--muted); font-size: 10.5px; }
</style>
