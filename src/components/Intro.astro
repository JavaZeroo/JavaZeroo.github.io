---
import Icon from './Icon.astro';
import { INTRO, SOCIALS } from '../consts';
---
<section class="intro">
  <h1>
    {INTRO.lines.map((line, i) => (<>{line}{i < INTRO.lines.length - 1 && <br />}</>))}
    {' '}<em>{INTRO.em}</em>
  </h1>
  <div class="intro-links">
    {SOCIALS.map(({ name, href, icon }) => (
      <a class="u" href={href}
         rel={href.startsWith('http') ? 'me noopener' : undefined}
         target={href.startsWith('http') ? '_blank' : undefined}>
        <Icon name={icon} />{name}
      </a>
    ))}
  </div>
</section>
