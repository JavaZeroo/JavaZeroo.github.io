---
/**
 * 在 SVG 里放一段可中英混排的标签，`$...$` 之间是公式。
 * 公式在构建期由 MathJax 渲染成 SVG 路径，中文部分是普通 <text>，整体是纯 SVG，没有 <foreignObject>，
 * 所以在 Safari 里也能正确随 viewBox 缩放。
 * (x, y) 是锚点：y 是垂直中心，x 按 align 是左端 / 中心 / 右端。w、h 只是为了兼容旧调用，不再使用。
 */
import { layoutLabel, textWidth } from './tex';
interface Props {
  x: number; y: number; w?: number; h?: number;
  size?: number; align?: 'start' | 'middle' | 'end';
  color?: string; weight?: number | string; src: string;
}
const { x, y, size = 12, align = 'middle', color = 'var(--text)', weight = 400, src } = Astro.props;
const wt = Number(weight) || 400;
const { segs, width } = layoutLabel(src, size, wt);
const x0 = align === 'middle' ? x - width / 2 : align === 'end' ? x - width : x;
// 视觉中心到基线的距离：无衬线中文字形约 0.36em
const baseline = y + size * 0.36;
const items = segs.map((s) => {
  if (s.kind === 'text') {
    const lead = s.text.length - s.text.trimStart().length;
    return { kind: 'text' as const, x: x0 + s.x + textWidth(s.text.slice(0, lead), size, wt), text: s.text.trim() };
  }
  return { kind: 'math' as const, x: x0 + s.x, y: baseline - s.ascent, width: s.width, height: s.height, vb: s.vb.join(' '), inner: s.inner };
});
---
<g class="svgtex" style={`color:${color}`} font-size={size} font-weight={wt}>
  {items.map((it) => it.kind === 'text'
    ? <text x={it.x} y={baseline} fill="currentColor">{it.text}</text>
    : <svg x={it.x} y={it.y} width={it.width} height={it.height} viewBox={it.vb} overflow="visible" set:html={it.inner} />
  )}
</g>
