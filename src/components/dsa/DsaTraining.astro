---
/** 两阶段训练的梯度边界。两张窄图并排或纵排，虚线表示已 detach 的教师目标。 */
import FlowDiagram from '../figures/FlowDiagram.astro';
const warmNodes = [
  { id: 'main', x: 15, y: 25, w: 280, h: 54, kind: 'mla', lines: ['主模型冻结', '稠密注意力 → 教师概率'] },
  { id: 'idx', x: 15, y: 120, w: 150, h: 54, kind: 'main', lines: ['indexer', '预测全历史概率'] },
  { id: 'kl', x: 75, y: 215, w: 220, h: 54, kind: 'out', lines: ['全局 KL', '只更新 indexer'] },
];
const warmEdges = [
  { from: 'main', to: 'idx', label: '冻结表示', lx: 35, ly: 101 },
  { from: 'main', to: 'kl', path: 'M295 52 H314 V242 H297', dashed: true },
  { from: 'idx', to: 'kl', label: '预测分布', lx: 95, ly: 185 },
];
const sparseNodes = [
  { id: 'main', x: 10, y: 25, w: 140, h: 54, kind: 'mla', lines: ['主模型表示', '$h, c^Q$'] },
  { id: 'idx', x: 200, y: 25, w: 140, h: 54, kind: 'main', lines: ['indexer', '打分 → top-k'] },
  { id: 'attn', x: 10, y: 126, w: 140, h: 54, kind: 'mla', lines: ['稀疏主注意力', '只看所选集合'] },
  { id: 'kl', x: 200, y: 215, w: 140, h: 54, kind: 'out', lines: ['集合内 KL', '只更新 indexer'] },
  { id: 'lm', x: 10, y: 215, w: 140, h: 54, kind: 'out', lines: ['语言模型损失', '只更新主模型'] },
];
const sparseEdges = [
  { from: 'main', to: 'idx', label: 'detach', lx: 152, ly: 40 },
  { from: 'main', to: 'attn' },
  { from: 'idx', to: 'attn', path: 'M270 79 V103 H80 V124', label: '下标无梯度', lx: 170, ly: 94 },
  { from: 'attn', to: 'lm' },
  { from: 'idx', to: 'kl', path: 'M340 52 H347 V242 H342' },
  { from: 'attn', to: 'kl', path: 'M150 153 H270 V213', dashed: true, label: '教师 detach', lx: 174, ly: 141 },
];
---
<div class="dsa-training-panels">
  <section class="dsa-training-stage" aria-label="阶段 A 稠密热身">
  <header><strong>A · 稠密热身</strong><span>1000 步 · 约 2.1B token</span></header>
  <FlowDiagram id="dsa-warmup" viewBox="0 0 330 290" minWidth={0} fontScale={1.35} nodes={warmNodes} edges={warmEdges}
    label="阶段 A：冻结稠密主模型，全局 KL 只训练索引器"
    caption="先学会选择：教师覆盖全部合法历史。" />
  </section>
  <section class="dsa-training-stage" aria-label="阶段 B 稀疏继续训练">
  <header><strong>B · 稀疏继续训练</strong><span>15000 步 · 约 943.7B token</span></header>
  <FlowDiagram id="dsa-sparse" viewBox="0 0 355 290" minWidth={0} fontScale={1.35} nodes={sparseNodes} edges={sparseEdges}
    label="阶段 B：主模型由语言损失训练，索引器由选中集合内 KL 训练，输入和教师 detach"
    caption="再适应稀疏输入：虚线教师不传梯度。" />
  </section>
</div>
<style>
  .dsa-training-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; margin: 1.8rem 0; }
  .dsa-training-stage { min-width: 0; }
  .dsa-training-stage header { display: grid; gap: .2rem; }
  .dsa-training-stage strong { color: var(--text); font-size: 1.03rem; }
  .dsa-training-stage header span { color: var(--text-2); font-size: .85rem; }
  .dsa-training-stage :global(figure.fd) { margin: .6rem 0 0; }
  @media (max-width: 760px) { .dsa-training-panels { grid-template-columns: 1fr; gap: 1.2rem; } }
</style>
