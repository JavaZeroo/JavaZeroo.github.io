---
/** 用 8 选 2 对照全量索引扫描与稀疏主 KV 读取。无 props。 */
import DsaFigure from './DsaFigure.astro';
import SvgTex from '../figures/SvgTex.astro';
const scores = [0.13, 0.22, 0.92, 0.18, 0.68, 0.34, 0.27, 0.3];
const selected = (i: number) => i === 2 || i === 4;
const cx = (i: number) => 28 + i * 38;
---
<DsaFigure label="DSA 的两步：索引器扫描全部小 key，主注意力只读取选中的大 KV"
  caption="示意为 8 选 2；V3.2 实际每个 query 最多选 2048 个位置。同层各主注意力头共享下标，选择随 query 和层变化。">
  <svg class="dsa-svg" viewBox="0 0 320 325" role="img" aria-label="索引器给全部历史位置打分，选出第 3 和第 5 个位置">
    <SvgTex x={160} y={18} size={17} weight={600} src="① 小索引器：扫描全部历史" />
    <rect x="85" y="44" width="150" height="36" rx="8" fill="var(--bg-2)" stroke="var(--cat-cyan)" />
    <SvgTex x={160} y={62} size={14} src="当前 query" />
    <path class="dsa-arrow" d="M160 80 V102 H28 M160 102 H294" />
    {scores.map((_, i) => <g>
      <path class="dsa-arrow" d={`M${cx(i)} 102 V118`} />
      <rect x={cx(i) - 14} y="118" width="28" height="18" rx="3" fill="var(--cat-cyan)" opacity=".65" />
      <SvgTex x={cx(i)} y={153} size={13} src={String(i + 1)} />
    </g>)}
    <SvgTex x={160} y={184} size={13} color="var(--text-2)" src="点积 → ReLU → 按头加权" />
    {scores.map((s, i) => <rect x={cx(i) - 12} y={247 - s * 45} width="24" height={s * 45} rx="2"
      fill={selected(i) ? 'var(--cat-cyan)' : 'var(--muted)'} opacity={selected(i) ? 1 : .3} />)}
    <path class="dsa-axis" d="M12 248 H310" />
    <SvgTex x={160} y={280} size={16} weight={600} color="var(--cat-cyan)" src="top-k 下标：3、5" />
    <SvgTex x={160} y={303} size={12} color="var(--text-2)" src="索引 key：每个位置一份低维向量" />
  </svg>
  <svg class="dsa-svg" viewBox="0 0 320 325" role="img" aria-label="主 MLA 保留全部缓存，但这一步只读取第 3 和第 5 个 KV">
    <SvgTex x={160} y={18} size={17} weight={600} src="② 主注意力：只计算选中项" />
    <SvgTex x={160} y={61} size={14} color="var(--text-2)" src="主 KV 缓存仍保存全部历史" />
    {scores.map((_, i) => <g opacity={selected(i) ? 1 : .28}>
      <rect x={cx(i) - 14} y="89" width="28" height="63" rx="4" fill="var(--bg-2)" stroke={selected(i) ? 'var(--cat-indigo)' : 'var(--muted)'} stroke-width={selected(i) ? 2 : 1} />
      {[0, 1, 2].map(n => <rect x={cx(i) - 9} y={99 + n * 15} width="18" height="8" rx="1" fill={selected(i) ? 'var(--cat-indigo)' : 'var(--muted)'} opacity=".65" />)}
      <SvgTex x={cx(i)} y={168} size={13} src={String(i + 1)} />
    </g>)}
    <path class="dsa-arrow" d="M104 179 V194 H160 V208 M180 179 V194" />
    <rect x="24" y="209" width="272" height="42" rx="8" fill="var(--bg-2)" stroke="var(--cat-indigo)" />
    <SvgTex x={160} y={230} size={14} src="自己的 QK → softmax → 加权 value" />
    <path class="dsa-arrow" d="M160 252 V267 M155 261 L160 267 L165 261" />
    <SvgTex x={160} y={286} size={16} weight={600} color="var(--cat-emerald)" src="输出当前 token 的表示" />
    <SvgTex x={160} y={309} size={12} color="var(--text-2)" src="索引分数只决定选谁" />
  </svg>
</DsaFigure>
