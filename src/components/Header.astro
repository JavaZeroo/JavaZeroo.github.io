---
import Icon from './Icon.astro';
import { AUTHOR } from '../consts';
const path = Astro.url.pathname;
const links = [
  { href: '/archives/', label: '归档' },
  { href: '/categories/', label: '分类' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{AUTHOR}</a>
    <nav class="site-nav">
      {links.map(({ href, label }) => (
        <a class="u" href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
      <button class="theme-btn" type="button" aria-label="切换深浅色主题" data-theme-toggle>
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>
    </nav>
  </div>
</header>

<script>
  // With the client router, module scripts run once per session; everything
  // that touches the DOM must re-run on astro:page-load.
  const init = () => {
    const root = document.documentElement;
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    });
  };
  document.addEventListener('astro:page-load', init);
</script>
