---
/**
 * Engram 的门控与写回。查表得到的 6144 维向量过一个线性层 wkv，切成 4 个 key（每条 mHC 残差流一个）
 * 和 1 个共用的 value。每条流和自己的 key 做归一化点积，过带符号的平方根和 sigmoid 得到一个标量门，
 * 同一个 value 乘 4 个不同的门，分别加回 4 条流。
 */
import FlowDiagram from '../figures/FlowDiagram.astro';
interface Props { caption?: string }
const { caption } = Astro.props;

const nodes = [
  { id: 'e', x: 16, y: 98, w: 124, h: 50, kind: 'vision', lines: ['查表结果 $e_t$', '6144 维'] },
  { id: 'wkv', x: 168, y: 98, w: 140, h: 50, lines: ['线性层 wkv', '6144 → 5 × 5120'] },
  { id: 'h', x: 344, y: 18, w: 176, h: 50, kind: 'in', lines: ['4 条残差流', '$h^{(1)}, \\dots, h^{(4)}$'] },
  { id: 'k', x: 344, y: 98, w: 176, h: 50, kind: 'mla', lines: ['4 个 key', '$k^{(1)}, \\dots, k^{(4)}$，每条流一个'] },
  { id: 'v', x: 344, y: 178, w: 176, h: 50, kind: 'mla', lines: ['1 个 value', '$v$，4 条流共用'] },
  { id: 'g', x: 560, y: 50, w: 196, h: 66, kind: 'attnres', strong: true, lines: ['4 个门 $\\alpha^{(m)}$', '归一化点积', '带符号的平方根，再过 sigmoid'] },
  { id: 'o', x: 796, y: 118, w: 178, h: 56, kind: 'vision', strong: true, lines: ['加回 4 条残差流', '$h^{(m)} \\leftarrow h^{(m)} + \\alpha^{(m)} v$'] },
];
const edges = [
  { from: 'e', to: 'wkv' },
  { from: 'wkv', to: 'k' },
  { from: 'wkv', to: 'v', path: 'M308 123 H 326 V 203 H 342' },
  { from: 'h', to: 'g' },
  { from: 'k', to: 'g' },
  { from: 'g', to: 'o', path: 'M756 83 H 776 V 138 H 794' },
  { from: 'v', to: 'o', path: 'M520 203 H 776 V 156 H 794' },
];
---

<FlowDiagram id="engramgate" viewBox="0 0 990 246" minWidth={800} label="Engram 的门控与写回残差流"
  nodes={nodes} edges={edges} caption={caption} />
