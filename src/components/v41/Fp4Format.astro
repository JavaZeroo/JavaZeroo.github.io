---
/**
 * FP4（E2M1）能表示哪些数，以及一条全局 KV 在缓存里怎么摆。
 * 上：E2M1 的 15 个可表示的值画在数轴上，乘上这一组的 scale 才是真实值；间距不均匀，越靠外越稀。
 * 下：一条 main KV = 512 个 4 bit 数（256 B）+ 32 个 scale（每 16 个通道一个，E4M3，32 B）；
 *     一条 indexer K = 128 个 4 bit 数（64 B）+ 4 个 scale（每 32 维一个，E8M0，4 B）。
 * 条的宽度正比于字节数。
 */
interface Props { caption?: string }
const { caption } = Astro.props;

const mags = [0, 0.5, 1, 1.5, 2, 3, 4, 6];
const vals = [...mags.slice(1).map((m) => -m).reverse(), ...mags];
const AX0 = 60, AX1 = 860, AY = 62;
const vx = (v: number) => (AX0 + AX1) / 2 + (v / 6) * ((AX1 - AX0) / 2);
const BY = 138, BH = 30, U = 2.1, BX = 150;   // 每字节 2.1px
const segs = (y: number, parts: { b: number; c: string; t: string }[]) => {
  let x = BX;
  return parts.map((p) => { const o = { ...p, x, y, w: p.b * U }; x += p.b * U; return o; });
};
const main = segs(BY, [{ b: 256, c: 'pay', t: '512 个 4 bit 数 = 256 B' }, { b: 32, c: 'sc', t: '32 B' }]);
const idx = segs(BY + 62, [{ b: 64, c: 'pay', t: '128 × 4 bit = 64 B' }, { b: 4, c: 'sc', t: '' }]);
---

<figure class="fp4">
  <svg viewBox="0 0 920 262" role="img" aria-label="FP4 的可表示值与一条全局 KV 的存储布局">
    <text class="ttl" x="20" y="22">E2M1 能表示的 15 个值（乘 scale 之前）</text>
    <line class="axis" x1={AX0 - 10} y1={AY} x2={AX1 + 10} y2={AY} />
    {vals.map((v) => (
      <g>
        <line class="tk" x1={vx(v)} y1={AY - 9} x2={vx(v)} y2={AY + 9} />
        <text class="tl" x={vx(v)} y={AY + 24} text-anchor="middle">{v}</text>
      </g>
    ))}
    <text class="note" x={vx(5)} y={AY - 16} text-anchor="middle">4 和 6 之间没有别的值</text>
    <text class="note" x={vx(0.75)} y={AY - 16} text-anchor="middle">0 附近间隔 0.5</text>

    <text class="ttl" x="20" y={BY - 14}>一条全局 KV 的存储</text>
    <text class="lab" x={BX - 12} y={BY + 19} text-anchor="end">main KV，288 B</text>
    <text class="lab" x={BX - 12} y={BY + 62 + 19} text-anchor="end">indexer K，68 B</text>
    {[...main, ...idx].map((s) => (
      <g>
        <rect class:list={['seg', s.c]} x={s.x} y={s.y} width={s.w} height={BH} rx="3" />
        {s.t && <text class="st" x={s.x + s.w / 2} y={s.y + 19} text-anchor="middle">{s.t}</text>}
      </g>
    ))}
    <text class="note" x={main[1].x + main[1].w + 10} y={BY + 13}>32 个 scale，每 16 个通道一个</text>
    <text class="note" x={main[1].x + main[1].w + 10} y={BY + 27}>格式 E4M3，每个 1 字节</text>
    <text class="note" x={idx[1].x + idx[1].w + 10} y={BY + 62 + 13}>4 个 scale，每 32 维一个</text>
    <text class="note" x={idx[1].x + idx[1].w + 10} y={BY + 62 + 27}>格式 E8M0（2 的整数次幂），每个 1 字节</text>
    <text class="note" x={BX} y={BY + 62 + BH + 22}>条的宽度正比于字节数。两条合计 356 B。</text>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fp4 { margin: 2rem 0; padding: 0.9rem 0.7rem 0.5rem; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); overflow-x: auto; }
  .fp4 svg { display: block; width: 100%; min-width: 760px; height: auto; font-family: var(--font-sans); }
  .ttl { fill: var(--text); font-size: 12.5px; font-weight: 600; }
  .lab { fill: var(--text-2); font-size: 11.5px; }
  .note { fill: var(--muted); font-size: 10.5px; }
  .axis { stroke: var(--text-2); stroke-width: 1.3; }
  .tk { stroke: var(--cat-indigo); stroke-width: 2.2; }
  .tl { fill: var(--text-2); font-size: 10.5px; }
  .seg.pay { fill: color-mix(in srgb, var(--cat-indigo) 30%, var(--bg-2)); stroke: var(--cat-indigo); stroke-width: 1.3; }
  .seg.sc { fill: color-mix(in srgb, var(--cat-amber) 45%, var(--bg-2)); stroke: var(--cat-amber); stroke-width: 1.3; }
  .st { fill: var(--text); font-size: 11px; }
  figcaption { margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-2); text-align: center; line-height: 1.6; }
</style>
