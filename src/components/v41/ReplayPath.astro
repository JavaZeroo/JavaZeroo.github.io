---
/**
 * 前缀命中缓存之后，一次请求要算哪些「层 × token」。横轴是 prompt 的位置：左边是命中缓存的前缀，右边是新来的后缀。
 * 上半是 encoder（第 0–19 层），下半是 decoder（第 20–39 层）。三栏：
 *  1. encoder 的滑窗 KV 还在内存池里：encoder 只算后缀；decoder 回放 prompt 最后 128 个 token。
 *  2. encoder 的滑窗 KV 已过期：encoder 多回放前缀的最后 128 个 token（只重建滑窗 KV，不重写全局 KV），再算后缀。
 *  3. 对照（我的估算）：精确重建。decoder 回放前缀最后 20 × 128 = 2560 个 token，它们需要精确的 encoder 输出，encoder 再往前回放到 5120 个。
 * 示意图，横向不按比例。
 */
import SvgTex from '../figures/SvgTex.astro';
interface Props { caption?: string }
const { caption } = Astro.props;

const PW = 250, PH = 130, GAP = 44, X0 = 62, Y0 = 66, SUF = 70;      // SUF：后缀的宽度
const panels = [
  { title: '滑窗 KV 还在内存池里', sub: 'encoder 只算新来的后缀', encRe: 0, decRe: 12, full: 0, cost: '$20\\,S + 20 \\times 128$' },
  { title: '滑窗 KV 已经过期', sub: 'Encoder SWA Bounded Replay', encRe: 12, decRe: 12, full: 0, cost: '$20\\,(S + 128) + 20 \\times 128$' },
  { title: '对照：精确重建（我的估算）', sub: 'encoder 回放 5120 个，decoder 回放 2560 个', encRe: 96, decRe: 88, full: 0, cost: '$20\\,(S + 5120) + 20 \\times 2560$' },
];
const px = (i: number) => X0 + i * (PW + GAP);
const W = px(2) + PW + 20;
---

<figure class="rpp">
  <svg viewBox={`0 0 ${W} 290`} role="img" aria-label="前缀命中缓存后三种情况下要计算的层与 token">
    <defs>
      <pattern id="rpp-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" class="hbg" /><line x1="0" y1="0" x2="0" y2="6" class="hln" />
      </pattern>
    </defs>
    {panels.map((p, i) => {
      const xs = px(i) + PW - SUF;          // 后缀起点
      return (
        <g>
          <text class="ttl" x={px(i)} y="22">{p.title}</text>
          <text class="sub" x={px(i)} y="40">{p.sub}</text>
          {p.full > 0
            ? <rect class="fill both" x={xs - p.full} y={Y0} width={p.full + SUF} height={PH} />
            : <g>
                <rect class="fill enc" x={xs} y={Y0} width={SUF} height={PH / 2} />
                {p.encRe > 0 && <rect class="fill re" x={xs - p.encRe} y={Y0} width={p.encRe} height={PH / 2} />}
                <rect class="fill dec" x={px(i) + PW - p.decRe} y={Y0 + PH / 2} width={p.decRe} height={PH / 2} />
              </g>}
          <rect class="frame" x={px(i)} y={Y0} width={PW} height={PH} />
          <line class="mid" x1={px(i) - 4} y1={Y0 + PH / 2} x2={px(i) + PW + 4} y2={Y0 + PH / 2} />
          <line class="cut" x1={xs} y1={Y0 - 8} x2={xs} y2={Y0 + PH + 8} />
          <text class="ax" x={px(i) + (PW - SUF) / 2} y={Y0 + PH + 20} text-anchor="middle">命中缓存的前缀</text>
          <text class="ax" x={xs + SUF / 2} y={Y0 + PH + 20} text-anchor="middle">新的后缀</text>
          <SvgTex x={px(i)} y={Y0 + PH + 46} size={12} align="start" src={`层 × token：${p.cost}`} />
        </g>
      );
    })}
    <text class="ax" x={X0 - 8} y={Y0 + PH / 4 + 4} text-anchor="end">encoder</text>
    <text class="ax" x={X0 - 8} y={Y0 + PH * 0.75 + 4} text-anchor="end">decoder</text>

    <g transform={`translate(${X0} ${Y0 + PH + 70})`}>
      <rect class="fill enc" x="0" y="0" width="14" height="12" /><text class="ax" x="20" y="10">encoder 正常计算</text>
      <rect class="fill re" x="140" y="0" width="14" height="12" /><text class="ax" x="160" y="10">只为重建滑窗 KV 的回放</text>
      <rect class="fill dec" x="330" y="0" width="14" height="12" /><text class="ax" x="350" y="10">decoder 的回放</text>
      
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .rpp { margin: 2rem 0; padding: 0.9rem 0.7rem 0.5rem; border: 1px solid var(--border); border-radius: var(--r); background: var(--surface); overflow-x: auto; }
  .rpp svg { display: block; width: 100%; min-width: 800px; height: auto; font-family: var(--font-sans); }
  .ttl { fill: var(--text); font-size: 12.5px; font-weight: 600; }
  .sub, .ax { fill: var(--muted); font-size: 10.5px; }
  .frame { fill: none; stroke: var(--text-2); stroke-width: 1.3; }
  .mid { stroke: var(--cat-cyan); stroke-width: 1.4; stroke-dasharray: 6 4; }
  .cut { stroke: var(--text-2); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .fill.enc { fill: color-mix(in srgb, var(--cat-indigo) 40%, var(--bg-2)); }
  .fill.dec { fill: color-mix(in srgb, var(--cat-amber) 60%, var(--bg-2)); }
  .fill.re { fill: url(#rpp-hatch); }
  .fill.both { fill: color-mix(in srgb, var(--cat-rose) 35%, var(--bg-2)); }
  .hbg { fill: color-mix(in srgb, var(--cat-indigo) 14%, var(--bg-2)); }
  .hln { stroke: var(--cat-indigo); stroke-width: 1.6; }
  figcaption { margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-2); text-align: center; line-height: 1.6; }
</style>
