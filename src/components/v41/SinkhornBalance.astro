---
/**
 * 交互：Sinkhorn-balanced update 对一个更新矩阵做了什么。8 行 × 6 列，行是 token（或 n-gram），列是特征。
 * 各行的原始幅度差几个数量级，其中一行接近 0。拖动步数 K：
 *   K = 0 是带动量的梯度本身；近零的行先被屏蔽；奇数步每行除以自己的 ℓ2 范数，偶数步每列除以自己的 ℓ2 范数；
 *   最后乘 √n，把「行的 ℓ2 范数为 1」换成「行的 RMS 为 1」。
 * 右边是每行的 RMS，下边是每列的 RMS。回答的问题：行和列的幅度是怎么被配平的，近零的行为什么要屏蔽。
 * 矩阵是固定种子的伪随机数，只为演示。
 */
---

<div class="demo skb-demo">
  <div class="ctl">
    <label>归一化步数 K = <output data-k-out>0</output>
      <input type="range" min="0" max="11" value="0" step="1" data-k />
    </label>
    <label><input type="checkbox" data-mask checked /> 屏蔽近零的行</label>
  </div>
  <svg viewBox="0 0 700 330" data-plot role="img" aria-label="Sinkhorn-balanced update 的行列归一化过程"></svg>
  <div class="res" data-res></div>
</div>

<style is:global>
  .skb-demo { border: 1px solid var(--border); border-radius: var(--r); padding: 1rem 1.1rem; background: var(--surface); margin: 1.5rem 0; overflow-x: auto; }
  .skb-demo .ctl { display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; font-size: 0.9rem; color: var(--text-2); }
  .skb-demo .ctl input[type='range'] { vertical-align: middle; width: 200px; margin-left: 0.6rem; }
  .skb-demo .ctl output { font-variant-numeric: tabular-nums; color: var(--text); font-weight: 600; }
  .skb-demo svg { display: block; width: 100%; min-width: 600px; height: auto; margin-top: 0.6rem; font-family: var(--font-sans); }
  .skb-demo .cell { stroke: var(--border-2); stroke-width: 0.8; }
  .skb-demo .cv { fill: var(--text); font-size: 10px; font-variant-numeric: tabular-nums; }
  .skb-demo .ax { fill: var(--text-2); font-size: 11px; font-weight: 600; }
  .skb-demo .lb { fill: var(--muted); font-size: 10px; }
  .skb-demo .rb { fill: color-mix(in srgb, var(--cat-emerald) 55%, var(--bg-2)); }
  .skb-demo .rb.off { fill: color-mix(in srgb, var(--muted) 40%, var(--bg-2)); }
  .skb-demo .one { stroke: var(--cat-rose); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .skb-demo .res { margin-top: 0.4rem; font-size: 0.88rem; color: var(--text-2); line-height: 1.7; }
</style>

<script>
  const init = () => document.querySelectorAll<HTMLElement>('.skb-demo').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const kIn = q<HTMLInputElement>('[data-k]'), kOut = q<HTMLOutputElement>('[data-k-out]'), mk = q<HTMLInputElement>('[data-mask]');
    const svg = q<SVGSVGElement>('[data-plot]'), res = q<HTMLElement>('[data-res]');
    const M = 8, N = 6, TAU = 1e-3, EPS = 1e-20;
    let seed = 20261002;
    const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff) * 2 - 1;
    const rowScale = [5, 2, 1, 0.5, 0.2, 0.05, 1e-5, 1];
    const colScale = [1, 3, 0.4, 1, 2, 0.6];
    const G = rowScale.map((rs) => colScale.map((cs) => rs * cs * (rnd() + (rnd() > 0 ? 0.35 : -0.35))));
    const l2 = (v: number[]) => Math.sqrt(v.reduce((s, x) => s + x * x, 0));
    const render = () => {
      const K = Number(kIn.value);
      kOut.textContent = String(K);
      let U = G.map((r) => r.slice());
      const rho = U.map(l2), rbar = rho.reduce((a, b) => a + b, 0) / M;
      const masked = rho.map((r) => mk.checked && r <= TAU * rbar);
      U = U.map((r, i) => (masked[i] ? r.map(() => 0) : r));
      for (let k = 1; k <= K; k++) {
        if (k % 2) U = U.map((r) => { const n = l2(r) + EPS; return r.map((x) => x / n); });
        else {
          const cn = Array.from({ length: N }, (_, j) => l2(U.map((r) => r[j])) + EPS);
          U = U.map((r) => r.map((x, j) => x / cn[j]));
        }
      }
      const D = K === 0 ? U : U.map((r) => r.map((x) => x * Math.sqrt(N)));   // K = 0 时显示原始值
      const rrms = D.map((r) => l2(r) / Math.sqrt(N));
      const crms = Array.from({ length: N }, (_, j) => l2(D.map((r) => r[j])) / Math.sqrt(M));
      const X0 = 80, Y0 = 44, CW = 62, CH = 26, BARX = X0 + N * CW + 30, BW = 150;
      const cap = K === 0 ? 3 : 2.5;
      const col = (v: number) => {
        const t = Math.min(Math.abs(v) / cap, 1) * 70;
        return `color-mix(in srgb, var(${v >= 0 ? '--cat-indigo' : '--cat-amber'}) ${t.toFixed(0)}%, var(--bg-2))`;
      };
      const fmt = (v: number) => (Math.abs(v) < 5e-4 ? '0' : Math.abs(v) >= 10 ? v.toFixed(0) : v.toFixed(2));
      const bw = (v: number) => Math.min(v, 2.2) / 2.2 * BW;
      svg.innerHTML =
        `<text class="ax" x="${X0}" y="20">${K === 0 ? '带动量的梯度（归一化之前）' : `更新矩阵（第 ${K} 步${K % 2 ? '，刚做完行归一化' : '，刚做完列归一化'}）`}</text>` +
        `<text class="ax" x="${BARX}" y="20">每行的 RMS</text>` +
        D.map((r, i) =>
          `<text class="lb" x="${X0 - 8}" y="${Y0 + i * CH + 17}" text-anchor="end">${masked[i] ? '已屏蔽' : `行 ${i + 1}`}</text>` +
          r.map((v, j) => `<rect class="cell" x="${X0 + j * CW}" y="${Y0 + i * CH}" width="${CW - 2}" height="${CH - 2}" rx="2" style="fill:${col(v)}"/>` +
            `<text class="cv" x="${X0 + j * CW + CW / 2 - 1}" y="${Y0 + i * CH + 16}" text-anchor="middle">${fmt(v)}</text>`).join('') +
          `<rect class="rb${masked[i] ? ' off' : ''}" x="${BARX}" y="${Y0 + i * CH + 3}" width="${Math.max(bw(rrms[i]), 1)}" height="${CH - 8}" rx="2"/>` +
          `<text class="lb" x="${BARX + Math.max(bw(rrms[i]), 1) + 6}" y="${Y0 + i * CH + 16}">${fmt(rrms[i])}</text>`).join('') +
        `<line class="one" x1="${BARX + bw(1)}" x2="${BARX + bw(1)}" y1="${Y0 - 6}" y2="${Y0 + M * CH}"/>` +
        `<text class="lb" x="${BARX + bw(1)}" y="${Y0 + M * CH + 12}" text-anchor="middle">1</text>` +
        `<text class="ax" x="${X0 - 8}" y="${Y0 + M * CH + 30}" text-anchor="end">每列的 RMS</text>` +
        crms.map((v, j) => `<text class="cv" x="${X0 + j * CW + CW / 2 - 1}" y="${Y0 + M * CH + 30}" text-anchor="middle">${fmt(v)}</text>`).join('');
      const act = rrms.filter((_, i) => !masked[i]);
      res.textContent = K === 0
        ? `各行的 RMS 从 ${fmt(Math.max(...act))} 到 ${fmt(Math.min(...act))}，相差几十倍。`
        : `未屏蔽的行，RMS 在 ${fmt(Math.min(...act))} 到 ${fmt(Math.max(...act))} 之间；各列的 RMS 在 ${fmt(Math.min(...crms))} 到 ${fmt(Math.max(...crms))} 之间。`;
    };
    kIn.addEventListener('input', render); mk.addEventListener('change', render);
    render();
  });
  document.addEventListener('astro:page-load', init);
  if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
</script>
