---
import FormattedDate from './FormattedDate.astro';
import type { Post } from '../utils/posts';
import { urlOf, readingTime } from '../utils/posts';
import { catLabel, catColor } from '../utils/taxonomy';

interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ul class="rows">
  {posts.map((post, i) => {
    const cat = post.data.categories[0];
    return (
      <li class="row reveal" style={`--c:${cat ? catColor(cat) : 'var(--accent)'};--d:${Math.min(i, 8) * 40}ms`}>
        <span class="label"><FormattedDate date={post.data.pubDate} /></span>
        <span class="t"><a href={urlOf(post)}>{post.data.title}</a></span>
        <span class="tail label">{cat && <span class="cat">{catLabel(cat)}</span>} · {readingTime(post)} min</span>
      </li>
    );
  })}
</ul>
