---
import Icon from './Icon.astro';
import { SITE_TITLE, TAGLINE, AVATAR, SOCIALS } from '../consts';
---
<section class="hero">
  <img class="hero-avatar" src={AVATAR} alt="" width="84" height="84" loading="eager" />
  <div>
    <h1>{SITE_TITLE}</h1>
    <p>{TAGLINE}</p>
    <div class="hero-socials">
      {SOCIALS.map(({ name, href, icon }) => (
        <a href={href} title={name} aria-label={name}
           rel={href.startsWith('http') ? 'me noopener' : undefined}
           target={href.startsWith('http') ? '_blank' : undefined}>
          <Icon name={icon} />
        </a>
      ))}
    </div>
  </div>
</section>
