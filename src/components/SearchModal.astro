---
import Icon from './Icon.astro';
---
<div class="search-root" data-search hidden>
  <div class="search-panel glass" role="dialog" aria-modal="true" aria-label="站内搜索">
    <label class="search-input">
      <Icon name="search" />
      <input type="search" aria-label="搜索文章" placeholder="搜索文章…" autocomplete="off" data-search-input />
      <kbd>ESC</kbd>
    </label>
    <ul class="search-results" data-search-results aria-live="polite" aria-busy="false"></ul>
  </div>
</div>

<script>
  type Result = { url: string; meta: { title?: string }; excerpt: string };
  type PF = { init(): Promise<void>; search(q: string): Promise<{ results: { data(): Promise<Result> }[] }> };
  let pending: Promise<PF | null> | undefined;
  let retries = 0;

  function load(): Promise<PF | null> {
    if (pending) return pending;
    pending = (async () => {
      try {
        // Built by astro-pagefind after `astro build`; served from dist in dev.
        // Keep Vite from rewriting this dynamic import in an inlined script.
        const load = new Function('p', 'return import(p)') as (p: string) => Promise<PF>;
        const pf = await load(`/pagefind/pagefind.js${retries ? `?retry=${retries}` : ''}`);
        await pf.init();
        return pf;
      } catch (e) {
        console.error('[search] pagefind failed to load', e);
        pending = undefined;
        retries++;
        return null;
      }
    })();
    return pending;
  }

  let ac: AbortController | undefined;

  const init = () => {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;
    const root = document.querySelector<HTMLElement>('[data-search]');
    const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
    const list = root?.querySelector<HTMLUListElement>('[data-search-results]');
    if (!root || !input || !list) return;

    let active = 0;
    let version = 0;
    let t: number | undefined;
    const cancel = () => {
      version++;
      clearTimeout(t);
      list.setAttribute('aria-busy', 'false');
    };
    signal.addEventListener('abort', cancel, { once: true });
    window.addEventListener('pagehide', cancel, { signal });
    let opener: HTMLElement | null = null;
    const open = () => {
      cancel();
      opener = document.activeElement as HTMLElement | null;
      root.hidden = false; input.value = ''; list.innerHTML = ''; input.focus(); load();
    };
    const close = () => {
      cancel();
      root.hidden = true;
      // Back to whatever opened the dialog, so a keyboard user does not land
      // at the top of the document.
      opener?.focus();
      opener = null;
    };

    document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open, { signal }));
    root.addEventListener('click', (e) => { if (e.target === root) close(); }, { signal });
    addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); root.hidden ? open() : close(); }
      else if (e.key === 'Escape' && !root.hidden) close();
    }, { signal });

    // aria-modal alone does not stop Tab from walking the page behind, and the
    // dialog is a plain <div>, so the cycle is kept here by hand.
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const stops: HTMLElement[] = [input, ...list.querySelectorAll<HTMLAnchorElement>('a')];
      e.preventDefault();
      const at = stops.indexOf(document.activeElement as HTMLElement);
      stops[(Math.max(at, 0) + (e.shiftKey ? stops.length - 1 : 1)) % stops.length]?.focus();
    }, { signal });

    const escape = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const render = (items: Result[]) => {
      active = 0;
      list.innerHTML = items.length
        ? items.map((r, i) => `<li class="${i === 0 ? 'active' : ''}"><a href="${escape(r.url)}"><div class="st">${escape(r.meta.title ?? r.url)}</div><div class="sx">${r.excerpt}</div></a></li>`).join('')
        : `<li class="search-empty">没有找到相关文章</li>`;
    };

    input.addEventListener('input', () => {
      cancel();
      const current = version;
      const q = input.value.trim();
      if (!q) { list.innerHTML = ''; return; }
      const valid = () => current === version && !signal.aborted && !root.hidden;
      list.innerHTML = '<li class="search-empty">正在搜索…</li>';
      list.setAttribute('aria-busy', 'true');
      t = window.setTimeout(async () => {
        try {
          const api = await load();
          if (!valid()) return;
          if (!api) throw new Error('Search unavailable');
          const res = await api.search(q);
          if (!valid()) return;
          const items = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
          if (valid()) render(items);
        } catch {
          if (valid()) list.innerHTML = '<li class="search-empty">搜索暂时不可用，请稍后重新输入重试</li>';
        } finally {
          if (valid()) list.setAttribute('aria-busy', 'false');
        }
      }, 120);
    }, { signal });

    input.addEventListener('keydown', (e) => {
      const items = [...list.querySelectorAll('li')].filter((li) => !li.classList.contains('search-empty'));
      if (!items.length) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        items[active]?.classList.remove('active');
        active = (active + (e.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length;
        items[active]?.classList.add('active');
        items[active]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        items[active]?.querySelector('a')?.click();
      }
    }, { signal });
  };
  init();
</script>
