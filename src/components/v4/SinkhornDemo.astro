---
/**
 * 交互：一个 4×4 的原始矩阵 → exp → Sinkhorn-Knopp 交替行、列归一化，看它几步之内变成双随机矩阵。
 * 滑块调 logit 尺度（对应 mHC 里的 α_res）和迭代次数。
 */
import { texMix } from './tex';
---

<div class="demo sk-demo">
  <div class="ctl">
    <label>logit 尺度 = <output data-s-out>1.0</output><input type="range" min="0" max="40" value="10" data-s /></label>
    <label>Sinkhorn 轮数 <i>t</i> = <output data-t-out>0</output><input type="range" min="0" max="20" value="0" data-t /></label>
    <button type="button" data-rand>重新随机</button>
  </div>
  <svg viewBox="0 0 640 300" data-plot>
    <g data-cells></g>
    <text class="ax" x="60" y="20"><tspan data-title>M⁽⁰⁾ = exp(B̃)</tspan></text>
    <text class="ax" x="330" y="20">行和</text>
    <text class="ax" x="16" y="300">列和</text>
    <text class="ax" x="420" y="60"><tspan data-info></tspan></text>
    <text class="ax" x="420" y="84"><tspan data-info2></tspan></text>
    <text class="ax" x="420" y="108"><tspan data-info3></tspan></text>
  </svg>
  <p class="legend" set:html={texMix('每一轮先把每一行除以行和，再把每一列除以列和。$t = 0$ 是 $\\exp(\\tilde B)$ 本身；行和列和同时为 1 时就是双随机矩阵。右侧给出当前矩阵的谱范数 $\\|B\\|_2$，它在双随机时不超过 1。')} />
</div>

<style>
  .sk-demo { border: 1px solid var(--border); border-radius: var(--r); padding: 1rem 1.1rem; background: var(--surface); margin: 1.5rem 0; }
  .sk-demo .ctl { display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; align-items: end; font-size: 0.9rem; color: var(--text-2); }
  .sk-demo .ctl label { display: block; }
  .sk-demo output { font-variant-numeric: tabular-nums; color: var(--text); font-weight: 600; }
  .sk-demo input[type='range'] { display: block; width: 200px; margin-top: 0.3rem; accent-color: var(--accent); }
  .sk-demo button { background: var(--bg-2); color: var(--text); border: 1px solid var(--border-2); border-radius: 6px; padding: 0.3rem 0.7rem; cursor: pointer; }
  .sk-demo svg { display: block; width: 100%; height: auto; margin-top: 0.8rem; font-family: var(--font-sans); }
  .sk-demo .ax { fill: var(--text-2); font-size: 12px; }
  .sk-demo [data-cells] rect { stroke: var(--border-2); }
  .sk-demo [data-cells] text { font-size: 12px; fill: var(--text); font-variant-numeric: tabular-nums; }
  .sk-demo [data-cells] text.sum { fill: var(--cat-amber); font-weight: 600; }
  .sk-demo .legend { margin: 0.6rem 0 0; font-size: 0.85rem; color: var(--text-2); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.sk-demo').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const sIn = q<HTMLInputElement>('[data-s]'), tIn = q<HTMLInputElement>('[data-t]');
    const sOut = q<HTMLOutputElement>('[data-s-out]'), tOut = q<HTMLOutputElement>('[data-t-out]');
    const cells = q<SVGGElement>('[data-cells]');
    const info = q<SVGTSpanElement>('[data-info]'), info2 = q<SVGTSpanElement>('[data-info2]'), info3 = q<SVGTSpanElement>('[data-info3]');
    const n = 4;
    let G: number[][] = [];
    const randn = () => { let u = 0, v = 0; while (!u) u = Math.random(); while (!v) v = Math.random(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };
    const reseed = () => { G = Array.from({ length: n }, () => Array.from({ length: n }, randn)); };
    reseed();

    // 谱范数：对 BᵀB 做幂迭代
    const spec = (M: number[][]) => {
      let v = Array(n).fill(1 / Math.sqrt(n));
      for (let it = 0; it < 60; it++) {
        const Mv = M.map((r) => r.reduce((a, x, j) => a + x * v[j], 0));
        const w = Array.from({ length: n }, (_, j) => M.reduce((a, r, i) => a + r[j] * Mv[i], 0));
        const nm = Math.hypot(...w) || 1; v = w.map((x) => x / nm);
      }
      const Mv = M.map((r) => r.reduce((a, x, j) => a + x * v[j], 0));
      return Math.hypot(...Mv);
    };

    const render = () => {
      const s = Number(sIn.value) / 10, t = Number(tIn.value);
      sOut.textContent = s.toFixed(1); tOut.textContent = String(t);
      let M = G.map((r) => r.map((x) => Math.exp(s * x)));
      for (let k = 0; k < t; k++) {
        M = M.map((r) => { const sum = r.reduce((a, b) => a + b, 0); return r.map((x) => x / sum); });
        const cs = Array.from({ length: n }, (_, j) => M.reduce((a, r) => a + r[j], 0));
        M = M.map((r) => r.map((x, j) => x / cs[j]));
      }
      const rs = M.map((r) => r.reduce((a, b) => a + b, 0));
      const cs = Array.from({ length: n }, (_, j) => M.reduce((a, r) => a + r[j], 0));
      const X0 = 60, Y0 = 34, C = 60;
      const vmax = Math.max(...M.flat());
      let html = '';
      M.forEach((r, i) => r.forEach((x, j) => {
        const a = Math.min(1, x / vmax);
        html += `<rect x="${X0 + j * C}" y="${Y0 + i * C}" width="${C - 2}" height="${C - 2}" rx="4" fill="var(--cat-amber)" fill-opacity="${(0.08 + 0.7 * a).toFixed(2)}"/>`;
        html += `<text x="${X0 + j * C + C / 2 - 1}" y="${Y0 + i * C + C / 2 + 4}" text-anchor="middle">${x.toFixed(2)}</text>`;
      }));
      rs.forEach((v, i) => { html += `<text class="sum" x="${X0 + n * C + 30}" y="${Y0 + i * C + C / 2 + 4}" text-anchor="middle">${v.toFixed(2)}</text>`; });
      cs.forEach((v, j) => { html += `<text class="sum" x="${X0 + j * C + C / 2 - 1}" y="${Y0 + n * C + 22}" text-anchor="middle">${v.toFixed(2)}</text>`; });
      cells.innerHTML = html;
      const dev = Math.max(...rs.map((v) => Math.abs(v - 1)), ...cs.map((v) => Math.abs(v - 1)));
      info.textContent = `距双随机的最大偏差：${dev.toExponential(1)}`;
      info2.textContent = `谱范数 ‖B‖₂ = ${spec(M).toFixed(3)}`;
      info3.textContent = t === 0 ? '（未归一化，行和列和都不是 1）' : dev < 1e-3 ? '（已经是双随机矩阵）' : '';
    };
    sIn.addEventListener('input', render); tIn.addEventListener('input', render);
    q<HTMLButtonElement>('[data-rand]').addEventListener('click', () => { reseed(); render(); });
    render();
  });
</script>
