---
import FlowDiagram from '../figures/FlowDiagram.astro';

const paths = [
  { name: 'A', port: '22221' },
  { name: 'B', port: '22222' },
];
---

<div class="vpn-path">
  {paths.map(({ name, port }) => (
    <FlowDiagram
      id={`univpn-${name.toLowerCase()}`}
      viewBox="0 0 300 310"
      minWidth={260}
      nodes={[
        { id: 'local', x: 15, y: 10, w: 270, h: 60, kind: 'in', lines: ['Windows 本地入口', `127.0.0.1:${port}`] },
        { id: 'vpn', x: 15, y: 122, w: 270, h: 64, kind: 'main', lines: [`UniVPN 容器 ${name}`, '独立的 cnem_vnic 与路由'] },
        { id: 'target', x: 15, y: 238, w: 270, h: 60, kind: 'out', lines: [`内网 ${name} 的 SSH 服务器`, '10.80.0.11:22'] },
      ]}
      edges={[
        { from: 'local', to: 'vpn', label: '映射到容器 2222', lx: 162, ly: 99 },
        { from: 'vpn', to: 'target', label: `经 VPN ${name} 转发`, lx: 162, ly: 215 },
      ]}
      label={`本机通过端口 ${port} 访问 VPN ${name} 内网的路径`}
    />
  ))}
</div>
<p class="vpn-caption">两个容器的网卡和路由相互独立；即使内网 IP 相同，也可以通过不同本地端口访问。</p>

<style>
  .vpn-path { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .vpn-caption { text-align: center; font-size: .85em; opacity: .75; }
  @media (max-width: 600px) {
    .vpn-path { grid-template-columns: minmax(0, 1fr); max-width: 340px; margin-inline: auto; }
  }
</style>
