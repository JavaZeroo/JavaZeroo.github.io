---
/**
 * 远端开发容器通过电脑上的 SSH 回连、VPN 端口入口和跳板访问目标。
 * 箭头表示访问数据的方向；回连本身由电脑主动发起，无组件参数。
 */
import FlowDiagram from '../figures/FlowDiagram.astro';

const nodes = [
  { id: 'remote', x: 20, y: 20, w: 320, h: 62, kind: 'in', lines: ['远端 Linux 服务器或开发容器', '执行 ssh lab-node'] },
  { id: 'pc', x: 20, y: 132, w: 320, h: 62, kind: 'main', lines: ['Windows 电脑', 'Docker VPN 与本地端口 22220'] },
  { id: 'jump', x: 20, y: 244, w: 320, h: 62, kind: 'comm', lines: ['内网跳板机', 'VPN 可以访问的 SSH 入口'] },
  { id: 'node', x: 20, y: 356, w: 320, h: 62, kind: 'out', lines: ['目标服务器', '独立验证发起端的 SSH 密钥'] },
];
const edges = [
  { from: 'remote', to: 'pc', label: 'SSH 回连', lx: 194, ly: 108 },
  { from: 'pc', to: 'jump', label: 'VPN 端口转发', lx: 194, ly: 220 },
  { from: 'jump', to: 'node', label: 'ProxyJump', lx: 194, ly: 332 },
];
---

<div class="vpn-path">
<FlowDiagram
  id="vpn-ssh-access"
  viewBox="0 0 360 438"
  minWidth={300}
  nodes={nodes}
  edges={edges}
  label="远端开发环境经电脑 VPN 和跳板访问目标服务器的路径"
  caption="箭头是访问数据的方向；SSH 回连由 Windows 电脑主动建立。电脑的 VPN 和回连进程需要保持在线。"
/>
</div>

<style>
  .vpn-path { max-width: 440px; margin-inline: auto; }
</style>
