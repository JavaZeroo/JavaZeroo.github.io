---
/**
 * 两个版本的数据路径并排展示：Lite 由 Python SOCKS5 转发 TCP，
 * Full 由 WireGuard 与 netfilter 转发 IP 包；两版共用原生认证代码。无 props。
 */
import FlowDiagram from '../figures/FlowDiagram.astro';
const lite = [
  { id: 'apps', x: 30, y: 24, w: 300, h: 60, kind: 'in', lines: ['配置了 SOCKS5 的应用', '数字 IPv4 目标 · 仅 TCP CONNECT'] },
  { id: 'port', x: 30, y: 138, w: 300, h: 60, kind: 'main', lines: ['localhost TCP 1080', 'Docker 发布到本机回环地址'] },
  { id: 'proxy', x: 30, y: 252, w: 300, h: 70, kind: 'mla', lines: ['容器内 Python SOCKS5', '目标 CIDR、就绪状态与路由检查', '无 UDP / BIND / 域名解析'] },
  { id: 'bind', x: 30, y: 376, w: 300, h: 60, kind: 'comm', lines: ['出站 socket 绑定 cnem_vnic', 'VPN 失效不能回落到 eth0'] },
  { id: 'private', x: 30, y: 490, w: 300, h: 60, kind: 'out', lines: ['UniVPN 网关 → 授权内网', '数据经过 Python 用户态代理'] },
];
const full = [
  { id: 'apps', x: 30, y: 24, w: 300, h: 60, kind: 'in', lines: ['普通 Windows 应用', '原始 IP 与端口 · TCP / UDP'] },
  { id: 'windows', x: 30, y: 138, w: 300, h: 60, kind: 'main', lines: ['Windows WireGuard 网卡', '仅接管 AllowedIPs 中的目标'] },
  { id: 'wg', x: 30, y: 252, w: 300, h: 70, kind: 'mla', lines: ['Docker 容器内的 wg0', '通过 localhost UDP 接入', '与 UniVPN 同一网络命名空间'] },
  { id: 'filter', x: 30, y: 376, w: 300, h: 60, kind: 'comm', lines: ['iptables FORWARD 与 SNAT', '目标 CIDR / 源地址 / VPN 出口'] },
  { id: 'private', x: 30, y: 490, w: 300, h: 60, kind: 'out', lines: ['cnem_vnic → UniVPN 网关 → 内网', '数据不经过 Python 用户态代理'] },
];
---

<div class="vpn-diagram-grid">
  <div>
    <h3>Lite：应用代理转发 IPv4 TCP</h3>
    <FlowDiagram id="univpn-lite-data" viewBox="0 0 360 574" minWidth={300}
      nodes={lite} edges={[
        { from: 'apps', to: 'port', label: '应用显式选择代理' },
        { from: 'port', to: 'proxy', label: 'SOCKS5 握手与目标请求' },
        { from: 'proxy', to: 'bind', label: '白名单与探针就绪后连接' },
        { from: 'bind', to: 'private', label: '仅允许 VPN 接口' },
      ]}
      label="Lite 数据面：配置 SOCKS5 的应用经 localhost TCP、Python 代理和绑定 cnem_vnic 的 socket 访问 IPv4 TCP 目标"
      caption="不安装 WireGuard。每个应用选择代理，裸 SSH 或 HTTP 直连不会自动进入容器。" />
  </div>
  <div>
    <h3>Full：网卡与路由转发 IPv4 包</h3>
    <FlowDiagram id="univpn-full-data" viewBox="0 0 360 574" minWidth={300}
      nodes={full} edges={[
        { from: 'apps', to: 'windows', label: 'Windows 默认选路' },
        { from: 'windows', to: 'wg', label: '本机 WireGuard 隧道' },
        { from: 'wg', to: 'filter', label: '容器内核转发' },
        { from: 'filter', to: 'private', label: '就绪放行，失效 DROP' },
      ]}
      label="Full 数据面：普通应用经 Windows WireGuard、Docker wg0、过滤与源地址转换访问 UniVPN IPv4 内网"
      caption="宿主机需要 WireGuard。SNAT 使回复沿原 VPN 和本机 WireGuard 返回，支持 TCP / UDP。" />
  </div>
</div>

<style>
  .vpn-diagram-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-block: 1.4rem; }
  .vpn-diagram-grid h3 { margin-block: 0 .3rem; font-size: 1rem; }
  .vpn-diagram-grid :global(.fd) { margin-block: .6rem 0; height: calc(100% - 2rem); }
  @media (max-width: 640px) { .vpn-diagram-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
