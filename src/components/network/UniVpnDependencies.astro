---
/**
 * 运行依赖分为 Windows 主机、Linux 内核与容器用户态，
 * 避免把 WireGuard 内核接口误画成第二个服务容器。无 props。
 */
import FlowDiagram from '../figures/FlowDiagram.astro';
---

<div class="vpn-dependencies">
  <FlowDiagram id="univpn-host-deps" viewBox="0 0 340 328" minWidth={280}
    nodes={[
      { id: 'windows', x: 24, y: 20, w: 292, h: 58, kind: 'in', lines: ['Windows 主机', 'Docker CLI、PowerShell、WireGuard'] },
      { id: 'desktop', x: 24, y: 126, w: 292, h: 64, kind: 'main', lines: ['Docker Desktop / Compose', '构建镜像、隔离实例、发布 UDP'] },
      { id: 'vm', x: 24, y: 238, w: 292, h: 64, kind: 'mla', lines: ['WSL 2 Linux VM', '为 Linux 容器提供运行环境'] },
    ]}
    edges={[{ from: 'windows', to: 'desktop', label: '管理容器与本机入口' }, { from: 'desktop', to: 'vm', label: '本次实测使用的后端' }]}
    label="主机依赖：Windows 使用 Docker Desktop 和 Compose，经 WSL 2 运行 Linux 容器；Windows WireGuard 提供本机网卡"
    caption="Windows WireGuard 另提供本机虚拟网卡；创建 tunnel 服务需要管理员授权。" />

  <FlowDiagram id="univpn-kernel-deps" viewBox="0 0 340 328" minWidth={280}
    nodes={[
      { id: 'kernel', x: 24, y: 20, w: 292, h: 58, kind: 'in', lines: ['WSL 2 Linux 内核', '容器共享内核，不各自启动 VM'] },
      { id: 'capability', x: 24, y: 126, w: 292, h: 64, kind: 'comm', lines: ['网络能力与权限', 'WireGuard 支持、NET_ADMIN、TUN'] },
      { id: 'devices', x: 24, y: 238, w: 292, h: 64, kind: 'out', lines: ['每个容器独立的网络命名空间', 'wg0、cnem_vnic、路由与过滤规则'] },
    ]}
    edges={[{ from: 'kernel', to: 'capability', label: '提供接口和网络栈' }, { from: 'capability', to: 'devices', label: '允许配置本实例的网络' }]}
    label="内核依赖：WSL Linux 内核需支持 WireGuard，容器用 NET_ADMIN 与 TUN 在独立命名空间内创建网络接口"
    caption="wg0 是内核网络接口。默认方案只运行一个 VPN 容器，不需要额外的 WireGuard 守护容器。" />

  <FlowDiagram id="univpn-image-deps" viewBox="0 0 340 328" minWidth={280}
    nodes={[
      { id: 'image', x: 24, y: 20, w: 292, h: 58, kind: 'in', lines: ['Ubuntu 22.04 / amd64 镜像', '默认 native 构建目标'] },
      { id: 'control', x: 24, y: 126, w: 292, h: 64, kind: 'main', lines: ['Python 3 标准库 + 官方引擎', 'UniVPNCS、辅助服务与厂商库'] },
      { id: 'tools', x: 24, y: 238, w: 292, h: 64, kind: 'mla', lines: ['Linux 网络与进程工具', 'iproute2、iptables、wg、tini、CA'] },
    ]}
    edges={[{ from: 'image', to: 'control', label: '安装前端与认证运行时' }, { from: 'image', to: 'tools', path: 'M24 49 H8 V270 H22', label: '' }]}
    label="镜像依赖：Ubuntu amd64 提供 Python 标准库、用户自备的官方引擎、网络工具、tini 和 CA；不安装图形桌面"
    caption="厂商程序由用户自行下载后本地构建。当前前端不依赖额外 Python 第三方包，也不安装 Qt、X11 或 VNC。" />
</div>

<style>
  .vpn-dependencies { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-block: 1.4rem; }
  .vpn-dependencies :global(.fd) { margin: 0; }
  .vpn-dependencies :global(.fd:last-child) { grid-column: 1 / -1; width: min(100%, 430px); justify-self: center; }
  @media (max-width: 640px) {
    .vpn-dependencies { grid-template-columns: minmax(0, 1fr); }
    .vpn-dependencies :global(.fd:last-child) { width: 100%; }
  }
</style>
