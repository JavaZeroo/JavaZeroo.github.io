---
/**
 * 依赖分成共同宿主机与镜像、Lite 专用代理、Full 专用 WireGuard。
 * 避免把 Windows 程序画入 Linux VM，或暗示 Lite 依赖 WireGuard。无 props。
 */
import FlowDiagram from '../figures/FlowDiagram.astro';
---

<div class="vpn-dependencies">
  <FlowDiagram id="univpn-host-deps" viewBox="0 0 340 350" minWidth={280}
    nodes={[
      { id: 'windows', x: 24, y: 20, w: 292, h: 60, kind: 'in', lines: ['共同宿主机：Windows x64', 'Docker CLI · PowerShell 终端'] },
      { id: 'desktop', x: 24, y: 138, w: 292, h: 60, kind: 'main', lines: ['Docker Desktop / WSL2', 'Lite：docker run · Full：Compose'] },
      { id: 'vm', x: 24, y: 256, w: 292, h: 72, kind: 'mla', lines: ['共享 Linux 内核', '独立网络命名空间 · TUN', '容器权限：NET_ADMIN'] },
    ]}
    edges={[{ from: 'windows', to: 'desktop', label: '运行 Linux 容器' }, { from: 'desktop', to: 'vm', label: '两版共同的运行平台' }]}
    label="共同平台依赖：Windows Docker CLI 和终端，通过 Docker Desktop 与 WSL2 运行具有 TUN 和 NET_ADMIN 的 Linux 容器"
    caption="两版都仍有 Docker Desktop / WSL2 平台开销，Lite 不等于直接运行在 Windows 的轻量进程。" />

  <FlowDiagram id="univpn-image-deps" viewBox="0 0 340 350" minWidth={280}
    nodes={[
      { id: 'image', x: 24, y: 20, w: 292, h: 60, kind: 'in', lines: ['共同镜像基础：Ubuntu / amd64', 'Python 标准库 · tini · 网络工具 · CA'] },
      { id: 'vendor', x: 24, y: 138, w: 292, h: 60, kind: 'main', lines: ['原生认证代码 + 官方引擎', '首次官方下载与逐层 SHA256 校验'] },
      { id: 'cache', x: 24, y: 256, w: 292, h: 72, kind: 'mla', lines: ['具名卷只缓存已校验的 ZIP', '每个容器提取自己的运行副本', '密码和短信不写配置'] },
    ]}
    edges={[{ from: 'image', to: 'vendor', label: '公开镜像不含厂商二进制' }, { from: 'vendor', to: 'cache', label: '不执行厂商安装脚本' }]}
    label="共同镜像依赖：Python 标准库和网络工具，启动时校验并加载官方引擎，已验证的 ZIP 缓存在 Docker 卷"
    caption="无需本机 Python 或构建镜像。两版均无 Qt、X11、VNC 或额外 Python 第三方库。" />

  <FlowDiagram id="univpn-lite-deps" viewBox="0 0 340 350" minWidth={280}
    nodes={[
      { id: 'app', x: 24, y: 20, w: 292, h: 60, kind: 'in', lines: ['Lite 的应用依赖', '客户端需要支持 SOCKS5'] },
      { id: 'proxy', x: 24, y: 138, w: 292, h: 60, kind: 'main', lines: ['Python 标准库 SOCKS5', 'IPv4 TCP CONNECT · 精确目标 CIDR'] },
      { id: 'config', x: 24, y: 256, w: 292, h: 72, kind: 'out', lines: ['终端 wizard + Docker 配置卷', '无 Windows 脚本 / 网卡', '无 wireguard-tools'] },
    ]}
    edges={[{ from: 'app', to: 'proxy', label: '逐应用选择 localhost 代理' }, { from: 'proxy', to: 'config', label: '配置与启动均在容器终端' }]}
    label="Lite 专用依赖：应用支持 SOCKS5，容器使用 Python 标准库代理及配置卷，无 Windows 脚本或 WireGuard"
    caption="lite / 0.4.0-lite：不解析目标域名，不支持 UDP、BIND 或 IPv6。" />

  <FlowDiagram id="univpn-full-deps" viewBox="0 0 340 350" minWidth={280}
    nodes={[
      { id: 'host', x: 24, y: 20, w: 292, h: 60, kind: 'in', lines: ['Full 的 Windows 依赖', '启动器 · WireGuard 程序与网卡'] },
      { id: 'tools', x: 24, y: 138, w: 292, h: 60, kind: 'comm', lines: ['Full 容器：wireguard-tools', 'wg0 与 iptables 过滤 / SNAT'] },
      { id: 'kernel', x: 24, y: 256, w: 292, h: 72, kind: 'out', lines: ['Linux 内核 WireGuard / netfilter', '同一 VPN 容器内转发', '无需额外 WireGuard 服务容器'] },
    ]}
    edges={[{ from: 'host', to: 'tools', label: '配对密钥与本机 UDP 隧道' }, { from: 'tools', to: 'kernel', label: '用户态工具管理内核接口' }]}
    label="Full 专用依赖：Windows 官方 WireGuard 与启动器，容器 wireguard-tools，以及 Linux WireGuard 和 netfilter 内核能力"
    caption="full / 0.4.0-full：原始 IP 接入；latest 与 0.4.0 兼容指向 Full。宿主机安装可能需要 UAC。" />
</div>

<style>
  .vpn-dependencies { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-block: 1.4rem; }
  .vpn-dependencies :global(.fd) { margin: 0; }
  @media (max-width: 640px) { .vpn-dependencies { grid-template-columns: minmax(0, 1fr); } }
</style>
