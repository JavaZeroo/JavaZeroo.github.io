---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, SITE_URL } from '../consts';

interface Props { title: string; description?: string; type?: 'website' | 'article'; publishedAt?: Date; updatedAt?: Date; ogImage?: string }
const { title, description = SITE_DESCRIPTION, type = 'website', publishedAt, updatedAt, ogImage = 'og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const image = new URL(ogImage, Astro.site);

// Search engines read the article's dates and author from here rather than
// having to guess them out of the page chrome.
const jsonLd = type === 'article' && publishedAt ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: 'zh-CN',
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Person', name: AUTHOR, url: SITE_URL },
  publisher: { '@type': 'Person', name: AUTHOR, url: SITE_URL },
  mainEntityOfPage: canonical.href,
  image: image.href,
} : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('atom.xml', Astro.site)} />

<!-- HarmonyOS Sans SC, sliced by unicode-range; the browser fetches only the
     slices a page actually uses. Kept out of the Vite bundle on purpose.
     Each sheet is ~47 KB gzipped, so they are fetched as low-priority print
     stylesheets and promoted once loaded: the first frame paints in the system
     font instead of waiting for them. The ClientRouter keeps stylesheet links
     with a matching href across navigations, so the promoted sheet survives
     client-side page swaps. Only 400 and 700 ship; 500 fell back to 400. -->
<link rel="stylesheet" href="/fonts/harmonyos-sans-sc/400/result.css" media="print" onload="this.media='all'" />
<link rel="stylesheet" href="/fonts/harmonyos-sans-sc/700/result.css" media="print" onload="this.media='all'" />
<noscript>
  <link rel="stylesheet" href="/fonts/harmonyos-sans-sc/400/result.css" />
  <link rel="stylesheet" href="/fonts/harmonyos-sans-sc/700/result.css" />
</noscript>

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{type === 'article' && (updatedAt ?? publishedAt) && (
  <meta property="article:modified_time" content={(updatedAt ?? publishedAt)!.toISOString()} />
)}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#0b0f19" />
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<ClientRouter />

<!-- Dark is the default. Runs before first paint, and again after every
     client-side navigation because the router swaps <html>. -->
<script is:inline>
  (() => {
    const apply = () => {
      // Marks that JS runs at all: CSS keeps scroll-reveal content visible
      // without it. Re-applied after a swap, which replaces <html>.
      document.documentElement.classList.add('js');
      let light = false;
      try {
        const stored = localStorage.getItem('theme');
        light = stored ? stored === 'light' : matchMedia('(prefers-color-scheme: light)').matches;
      } catch {}
      document.documentElement.dataset.theme = light ? 'light' : 'dark';
    };
    apply();
    document.addEventListener('astro:after-swap', apply);
  })();
</script>
