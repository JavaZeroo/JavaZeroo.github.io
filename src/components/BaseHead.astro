---
import '../styles/global.css';
import { brandFontCss } from '../utils/brand-font';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, SITE_URL } from '../consts';

interface Props { title: string; description?: string; type?: 'website' | 'article'; publishedAt?: Date; updatedAt?: Date; ogImage?: string }
const { title, description = SITE_DESCRIPTION, type = 'website', publishedAt, updatedAt, ogImage = 'og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const image = new URL(ogImage, Astro.site);

// Search engines read the article's dates and author from here rather than
// having to guess them out of the page chrome.
const jsonLd = type === 'article' && publishedAt ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: 'zh-CN',
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Person', name: AUTHOR, url: SITE_URL },
  publisher: { '@type': 'Person', name: AUTHOR, url: SITE_URL },
  mainEntityOfPage: canonical.href,
  image: image.href,
} : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('atom.xml', Astro.site)} />

<!-- Only brand glyphs use the web font; no full font stylesheet waterfall. -->
<style is:inline set:html={brandFontCss} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{type === 'article' && (updatedAt ?? publishedAt) && (
  <meta property="article:modified_time" content={(updatedAt ?? publishedAt)!.toISOString()} />
)}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#0b0f19" />
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<ClientRouter />

<!-- Dark is the default. Runs before first paint, and again after every
     client-side navigation because the router swaps <html>. -->
<script is:inline>
  (() => {
    let watcher;
    // Keeps the browser UI (address bar, task switcher) on the page's own
    // background, whichever theme is active. Reads --bg so the two never drift
    // apart; the header's toggle only sets data-theme.
    const paint = () => {
      const bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
      if (bg) document.querySelector('meta[name="theme-color"]')?.setAttribute('content', bg);
    };
    const apply = () => {
      // Marks that JS runs at all: CSS keeps scroll-reveal content visible
      // without it. Re-applied after a swap, which replaces <html>.
      document.documentElement.classList.add('js');
      let light = false;
      try {
        const stored = localStorage.getItem('theme');
        light = stored ? stored === 'light' : matchMedia('(prefers-color-scheme: light)').matches;
      } catch {}
      document.documentElement.dataset.theme = light ? 'light' : 'dark';
      paint();
      watcher?.disconnect();
      watcher = new MutationObserver(paint);
      watcher.observe(document.documentElement, { attributeFilter: ['data-theme'] });
    };
    apply();
    document.addEventListener('astro:after-swap', apply);
  })();
</script>
