---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[]; mobile?: boolean }
// h1 is the post title; h5/h6 are too fine-grained to be useful here.
const { mobile = false } = Astro.props;
const items = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---
{mobile && items.length > 2 && (
  <details class="toc-mobile">
    <summary><span class="label">目录</span><span>{items.length} 节</span></summary>
    <ul>{items.map((h) => <li><a href={`#${h.slug}`} class={`d${h.depth}`}>{h.text}</a></li>)}</ul>
  </details>
)}
{!mobile && items.length > 2 && (
  <nav class="toc glass" aria-label="目录">
    <span class="label">目录</span>
    <ul>
      {items.map((h) => (
        <li><a href={`#${h.slug}`} class={`d${h.depth}`} data-toc-link={h.slug}>{h.text}</a></li>
      ))}
    </ul>
  </nav>
)}

<script>
  // See Header.astro: `init` runs again after every client-side navigation, so
  // the previous page's scroll listener has to go.
  let ac: AbortController | undefined;
  const init = () => {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (!links.length) return;
    const byId = new Map([...links].map((a) => [a.dataset.tocLink!, a]));
    const targets = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    // Highlight the last heading scrolled past, so the marker still moves
    // through a short trailing section that can never reach the top.
    let active: HTMLAnchorElement | undefined;
    let positions: number[] = [];
    let frame = 0;
    const sync = () => {
      frame = 0;
      const line = window.scrollY + 120;
      let current = targets[0];
      for (let i = 0; i < targets.length; i++) {
        if (positions[i] <= line) current = targets[i];
        else break;
      }
      const next = current && byId.get(current.id);
      if (next === active) return;
      active?.classList.remove('active');
      active?.removeAttribute('aria-current');
      next?.classList.add('active');
      next?.setAttribute('aria-current', 'location');
      active = next;
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(sync); };
    const measure = () => {
      positions = targets.map((target) => target.getBoundingClientRect().top + scrollY);
      schedule();
    };
    const observer = new ResizeObserver(measure);
    const article = document.querySelector('[data-article]');
    if (article) observer.observe(article);
    measure();
    addEventListener('scroll', schedule, { passive: true, signal });
    addEventListener('resize', measure, { signal });
    document.fonts.ready.then(() => { if (!signal.aborted) measure(); });
    signal.addEventListener('abort', () => { observer.disconnect(); cancelAnimationFrame(frame); }, { once: true });
  };
  document.addEventListener('astro:page-load', init);
</script>
