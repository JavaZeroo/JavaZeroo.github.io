---
import { AUTHOR, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <span>© {year} {AUTHOR}</span>
    <span>
      {SOCIALS.map(({ name, href }, i) => (
        <>{i > 0 && ' · '}<a href={href} rel="me noopener" target="_blank">{name}</a></>
      ))}
      {' · '}<a href="/atom.xml">RSS</a>
    </span>
  </div>
</footer>
