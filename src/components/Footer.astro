---
import { AUTHOR, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap label">
    <span>© {year} {AUTHOR}</span>
    <span class="links">
      {SOCIALS.map(({ name, href }) => (
        <a class="u" href={href}
           rel={href.startsWith('http') ? 'me noopener' : undefined}
           target={href.startsWith('http') ? '_blank' : undefined}>{name}</a>
      ))}
    </span>
  </div>
</footer>
