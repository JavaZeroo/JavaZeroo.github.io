---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../utils/posts';
import { SITE_TITLE, POSTS_PER_PAGE } from '../consts';

const posts = await getPosts();
const page = posts.slice(0, POSTS_PER_PAGE);
const hasNext = posts.length > POSTS_PER_PAGE;
---
<BaseLayout title={SITE_TITLE}>
  <PostList posts={page} />
  {hasNext && (
    <nav class="pagination"><span /><a href="/page/2/">下一页 →</a></nav>
  )}
</BaseLayout>
