---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../utils/posts';
import { SITE_TITLE, POSTS_PER_PAGE } from '../consts';

const posts = await getPosts();
const page = posts.slice(0, POSTS_PER_PAGE);
const hasNext = posts.length > POSTS_PER_PAGE;
---
<BaseLayout title={SITE_TITLE}>
  <Intro />
  <PostList posts={page} heading="文章" total={posts.length} />
  {hasNext && <nav class="pagination"><span /><a class="u" href="/page/2/">更早的文章 →</a></nav>}
</BaseLayout>
