---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, type Post } from '../../utils/posts';
import { POSTS_PER_PAGE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const total = Math.ceil(posts.length / POSTS_PER_PAGE);
  // Page 1 lives at `/`; this route only covers 2..n.
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => {
    const num = i + 2;
    return {
      params: { page: String(num) },
      props: { posts: posts.slice((num - 1) * POSTS_PER_PAGE, num * POSTS_PER_PAGE), num, total },
    };
  });
}

const { posts, num, total } = Astro.props as { posts: Post[]; num: number; total: number };
const prev = num === 2 ? '/' : `/page/${num - 1}/`;
---
<BaseLayout title={`第 ${num} 页`}>
  <header class="page-head"><h1>文章</h1><span class="label">第 {num} / {total} 页</span></header>
  <PostList posts={posts} />
  <nav class="pagination">
    <a class="u" href={prev}>← 更新的文章</a>
    {num < total ? <a class="u" href={`/page/${num + 1}/`}>更早的文章 →</a> : <span />}
  </nav>
</BaseLayout>
