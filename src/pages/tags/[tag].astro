---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, countBy, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const tags = countBy(await getPosts(), 'tags');
  return [...tags].map(([tag, posts]) => ({ params: { tag }, props: { posts, tag } }));
}

const { posts, tag } = Astro.props as { posts: Post[]; tag: string };
---
<BaseLayout title={`标签：${tag}`} description={`标签 ${tag} 下的文章。`}>
  <header class="page-head"><span class="label">标签</span><h1>#{tag}</h1><p>{posts.length} 篇</p></header>
  <PostList posts={posts} />
</BaseLayout>
