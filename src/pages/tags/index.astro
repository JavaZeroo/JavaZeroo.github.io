---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, countBy } from '../../utils/posts';

const items = countBy(await getPosts(), 'tags');
---
<BaseLayout title="标签" description="按标签浏览文章。">
  <header class="page-head"><span class="label">Tags</span><h1>标签</h1><p>共 {items.size} 个</p></header>
  <ul class="taxonomy">
    {[...items].map(([name, posts], i) => (
      <li class="card reveal" style={`--d:${i * 50}ms`}>
        <h3><a href={`/tags/${encodeURIComponent(name)}/`}>#{name}</a></h3>
        <span class="label">{posts.length} 篇</span>
      </li>
    ))}
  </ul>
</BaseLayout>
