---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, countBy } from '../../utils/posts';

const items = countBy(await getPosts(), 'tags');
---
<BaseLayout title="标签" description="按标签浏览文章。">
  <header class="page-head">
    <h1>标签</h1>
    <span class="label">共 {items.size} 个</span>
  </header>
  <ul class="taxonomy">
    {[...items].map(([name, posts]) => (
      <li>
        <a href={`/tags/${encodeURIComponent(name)}/`}>{name}</a>
        <span class="label">{posts.length} 篇</span>
      </li>
    ))}
  </ul>
</BaseLayout>
