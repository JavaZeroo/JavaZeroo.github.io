---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPostsByDate, groupByYear, urlOf } from '../utils/posts';

const groups = groupByYear(await getPostsByDate());
const total = groups.reduce((n, [, posts]) => n + posts.length, 0);
---
<BaseLayout title="归档" description="全部文章归档。">
  <header class="page-head">
    <h1>归档</h1>
    <span class="label">共 {total} 篇</span>
  </header>
  {groups.map(([year, posts]) => (
    <section class="year-group">
      <h2>{year}</h2>
      <ul class="archive-list">
        {posts.map((post) => (
          <li>
            <span class="label"><FormattedDate date={post.data.pubDate} format="day" /></span>
            <a href={urlOf(post)}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
