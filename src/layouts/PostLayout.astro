---
import type { MarkdownHeading } from 'astro';
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostNav from '../components/PostNav.astro';
import Comments from '../components/Comments.astro';
import type { Post } from '../utils/posts';
import { describe, readingTime, neighboursOf } from '../utils/posts';
import { catLabel } from '../utils/taxonomy';
import { seriesContext, seriesUrl } from '../utils/series';
import Icon from '../components/Icon.astro';

interface Props { post: Post; headings: MarkdownHeading[] }
const { post, headings } = Astro.props;
const { title, pubDate, updatedDate, description, categories, tags } = post.data;
// Inside a series, prev/next follow the reading order, not the calendar.
const ctx = await seriesContext(post);
const { prev, next } = ctx ?? (await neighboursOf(post));
// Migrated descriptions were cut from the opening paragraph; showing those as
// a lede would print the same sentence twice. Hand-written ones still show.
const showLede = !!description && !(post.body ?? '').includes(description.replace(/…$/, ''));
---
<BaseLayout title={title} description={describe(post)} type="article" publishedAt={pubDate} updatedAt={updatedDate} ogImage={`og/${encodeURIComponent(post.id)}.png`} wide>
  <div class="read-progress" data-progress></div>

  <div class="post-shell">
    <article class="post-main wrap" data-article data-pagefind-body>
      <header class="post-header">
        {ctx && (
          <a class="series-banner" href={seriesUrl(ctx.series.id)} style={`--c:${ctx.series.data.color}`} data-pagefind-ignore>
            <span class="label">专栏</span>
            <b>{ctx.series.data.title}</b>
            <span class="sep">·</span><span class="part">{post.data.part}</span>
            <span class="count label">{ctx.index} / {ctx.total}</span>
            <Icon name="arrow" />
          </a>
        )}
        <div class="label" data-pagefind-ignore>
          <FormattedDate date={pubDate} />
          <span>{readingTime(post)} min</span>
          {updatedDate && <span>更新 <FormattedDate date={updatedDate} /></span>}
          {categories.map((c) => <a href={`/categories/${encodeURIComponent(c)}/`}>{catLabel(c)}</a>)}
        </div>
        <h1 data-pagefind-meta="title" data-pagefind-weight="10">{title}</h1>
        {showLede && <p class="lede">{description}</p>}
      </header>

      <TableOfContents headings={headings} mobile />
      <div class="prose"><slot /></div>

      {tags.length > 0 && (
        <footer class="post-tags">
          {tags.map((t) => <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}
        </footer>
      )}

      <PostNav prev={prev} next={next} />
      <Comments />
    </article>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<script>
  let ac: AbortController | undefined;
  const init = () => {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;
    // Progress is measured against the article, not the page, so the footer
    // and nav never count as unread content.
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const article = document.querySelector<HTMLElement>('[data-article]');
    if (bar && article) {
      const sync = () => {
        const total = article.offsetTop + article.offsetHeight - innerHeight;
        const done = total <= 0 ? 1 : Math.min(Math.max(scrollY / total, 0), 1);
        bar.style.width = `${done * 100}%`;
      };
      sync();
      addEventListener('scroll', sync, { passive: true, signal });
      addEventListener('resize', sync, { signal });
    }

    // ---- figure zoom ----------------------------------------------------
    // Diagrams are authored on a ~1000-unit viewBox, so in the column they end
    // up near 1:1 and their labels sit around 12px. This lifts the figure into an
    // overlay scaled to the viewport instead of making the reader ctrl+scroll.
    const icon = (d: string) =>
      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
    const ZOOM = icon('<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6M11 8v6M8 11h6"/>');
    const CLOSE = icon('<path d="M6 6l12 12M18 6L6 18"/>');

    let closeBox = () => {};
    window.addEventListener('pagehide', () => closeBox(), { signal });
    signal.addEventListener('abort', () => closeBox(), { once: true });

    const openBox = (fig: HTMLElement, opener: HTMLElement) => {
      closeBox();
      const box = document.createElement('dialog');
      box.className = 'fig-lightbox';
      box.setAttribute('aria-label', '放大图表');
      const placeholder = document.createElement('div');
      placeholder.style.height = `${fig.getBoundingClientRect().height}px`;
      placeholder.style.margin = getComputedStyle(fig).margin;
      const originalStyle = fig.getAttribute('style');
      const originalOverflow = document.documentElement.style.overflow;
      fig.before(placeholder);
      const art = fig.querySelector('svg, img');
      const vb = art?.getAttribute('viewBox')?.split(/[\s,]+/).map(Number);
      const drawn = vb && vb.length === 4 ? { w: vb[2], h: vb[3] }
        : art instanceof HTMLImageElement && art.naturalHeight ? { w: art.naturalWidth, h: art.naturalHeight }
        : null;
      // Two cases. A screen that can show the whole figure gets it fitted, wide
      // ones limited by width and tall ones by height. A screen that cannot —
      // a phone — gets it at 1.2x the size it was drawn at, which is what makes
      // the labels legible, and pans inside .fig-scroll.
      const fit = drawn ? Math.min(innerWidth * 0.94, innerHeight * 0.88 * (drawn.w / drawn.h)) : 0;
      const fitted = !!drawn && fit >= drawn.w;
      if (drawn) fig.style.width = `${fitted ? fit : drawn.w * 1.2}px`;
      // The figures are translucent by design; over the scrim they need a floor.
      fig.style.background = 'var(--bg-2)';
      const scroll = document.createElement('div');
      scroll.className = 'fig-scroll prose';
      scroll.appendChild(fig);
      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'fig-close';
      close.setAttribute('aria-label', '关闭');
      close.innerHTML = CLOSE;
      box.append(scroll, close);
      let closed = false;
      closeBox = () => {
        if (closed) return;
        closed = true;
        placeholder.replaceWith(fig);
        if (originalStyle === null) fig.removeAttribute('style');
        else fig.setAttribute('style', originalStyle);
        document.documentElement.style.overflow = originalOverflow;
        box.close();
        box.remove();
        opener.focus({ preventScroll: true });
      };
      box.addEventListener('click', (e) => { if (e.target === box) closeBox(); });
      close.addEventListener('click', closeBox);
      box.addEventListener('cancel', (e) => { e.preventDefault(); closeBox(); });
      box.addEventListener('close', closeBox);
      box.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        const stops = [...box.querySelectorAll<HTMLElement>('button, a[href], input, select, textarea, [tabindex]')]
          .filter((el) => el.tabIndex >= 0 && !el.matches(':disabled') && el.checkVisibility());
        const index = stops.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        stops[(index + (e.shiftKey ? stops.length - 1 : 1)) % stops.length]?.focus();
      });
      document.body.appendChild(box);
      document.documentElement.style.overflow = 'hidden';
      box.showModal();
      // The viewBox covers the drawing only; padding, legend and caption add to
      // it. Measure once it is on screen and pull the width back if the figure
      // as a whole still runs past the bottom.
      const spare = (scroll.clientHeight - 2) / fig.getBoundingClientRect().height;
      if (fitted && spare < 1) {
        fig.style.width = `${Math.floor(fig.getBoundingClientRect().width * spare)}px`;
      }
      close.focus();
    };

    document.querySelectorAll<HTMLElement>('.prose figure').forEach((fig) => {
      if (!fig.querySelector('svg, img')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'fig-zoom';
      btn.setAttribute('aria-label', '放大这张图');
      btn.innerHTML = ZOOM;
      btn.addEventListener('click', () => openBox(fig, btn), { signal });
      fig.appendChild(btn);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const code = btn.closest('.code-block')?.querySelector('code');
        const label = btn.querySelector<HTMLElement>('[data-copy-label]');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          btn.classList.add('copied');
          if (label) label.textContent = '已复制';
        } catch {
          if (label) label.textContent = '失败';
        }
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = '复制';
        }, 1600);
      });
    });
  };
  init();
</script>
