---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { Post } from '../utils/posts';
import { describe } from '../utils/posts';

interface Props { post: Post }
const { post } = Astro.props;
const { title, pubDate, updatedDate, categories, tags } = post.data;
---
<BaseLayout title={title} description={describe(post)} type="article" publishedAt={pubDate}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}
        {categories.map((c) => <a class="chip" href={`/categories/${encodeURIComponent(c)}/`}>{c}</a>)}
      </div>
    </header>
    <div class="prose"><slot /></div>
    {tags.length > 0 && (
      <footer class="meta" style="margin-top:2.5rem">
        {tags.map((t) => <a class="chip" href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}
      </footer>
    )}
  </article>
</BaseLayout>
