---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props { title: string; description?: string; type?: 'website' | 'article'; publishedAt?: Date; wide?: boolean }
const { wide = false, ...head } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead {...head} /></head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <Header />
    <main id="main" class={wide ? undefined : 'wrap'}><slot /></main>
    <Footer />
    <SearchModal />
  </body>
</html>
