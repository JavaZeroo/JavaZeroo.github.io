---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** Posts opt out of the centred column so the TOC can sit in the margin. */
  wide?: boolean;
}
const { wide = false, ...head } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead {...head} /></head>
  <body>
    <Header />
    <main class={wide ? undefined : 'wrap'}><slot /></main>
    <Footer />
  </body>
</html>
