{
  "headers": [
    {
      "source": "/fonts/*.woff2",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/*.css",
      "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }]
    },
    {
      "source": "/_astro/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/pagefind/*",
      "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }]
    }
  ]
}
